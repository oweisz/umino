Dialogue: 0,0:00:01.20,0:00:01.30,Default,,0,0,0,,H V Ě Z D
Dialogue: 0,0:00:01.30,0:00:01.40,Default,,0,0,0,,H V Ě Z D N
Dialogue: 0,0:00:01.40,0:00:01.50,Default,,0,0,0,,H V Ě Z D N Á
Dialogue: 0,0:00:01.50,0:00:01.60,Default,,0,0,0,,H V Ě Z D N Á
Dialogue: 0,0:00:01.60,0:00:01.70,Default,,0,0,0,,H V Ě Z D N Á  L
Dialogue: 0,0:00:01.70,0:00:01.85,Default,,0,0,0,,H V Ě Z D N Á  L O
Dialogue: 0,0:00:01.85,0:00:02.00,Default,,0,0,0,,H V Ě Z D N Á  L O Ď
Dialogue: 0,0:00:02.00,0:00:02.15,Default,,0,0,0,,H V Ě Z D N Á  L O Ď
Dialogue: 0,0:00:02.15,0:00:02.30,Default,,0,0,0,,H V Ě Z D N Á  L O Ď  S
Dialogue: 0,0:00:02.30,0:00:02.45,Default,,0,0,0,,H V Ě Z D N Á  L O Ď  S T
Dialogue: 0,0:00:02.45,0:00:02.60,Default,,0,0,0,,H V Ě Z D N Á  L O Ď  S T Ř
Dialogue: 0,0:00:02.60,0:00:02.75,Default,,0,0,0,,H V Ě Z D N Á  L O Ď  S T Ř E
Dialogue: 0,0:00:02.75,0:00:02.90,Default,,0,0,0,,H V Ě Z D N Á  L O Ď  S T Ř E L
Dialogue: 0,0:00:02.90,0:00:03.05,Default,,0,0,0,,H V Ě Z D N Á  L O Ď  S T Ř E L E
Dialogue: 0,0:00:03.05,0:00:03.20,Default,,0,0,0,,H V Ě Z D N Á  L O Ď  S T Ř E L E C
Dialogue: 0,0:00:03.20,0:00:06.60,Default,,0,0,0,,H V Ě Z D N Á  L O Ď  S T Ř E L E C
Dialogue: 0,0:00:08.60,0:00:09.90,Default,,0,0,0,,H V Ě Z D N Á  L O Ď  S T Ř E L E C
Dialogue: 0,0:00:09.90,0:00:14.55,Default,,0,0,0,,HVĚZDNÁ LOĎ STŘELEC\NStardust boys!!!
Dialogue: 0,0:00:15.29,0:00:17.88,Default,,0,0,0,,{\i1}I když se na nás díváte,\Nnejsme žádní Supermani{\i}
Dialogue: 0,0:00:17.88,0:00:20.32,Default,,0,0,0,,{\i1}Nejsme ani hvězdy vesmírné opery{\i}
Dialogue: 0,0:00:20.32,0:00:22.59,Default,,0,0,0,,{\i1}A nikoho nezachráníme\Nv poslední chvíli{\i}
Dialogue: 0,0:00:22.59,0:00:27.00,Default,,0,0,0,,{\i1}A nevypadáme tak\njak byste čekali.{\i}
Dialogue: 0,0:00:27.60,0:00:30.20,Default,,0,0,0,,{\i1}A nejsme tak elegantní,\Nabyste si povzdechli,{\i}
Dialogue: 0,0:00:32.33,0:00:34.92,Default,,0,0,0,,{\i1}A ani se nezjevujeme v dětských snech,{\i}
Dialogue: 0,0:00:34.92,0:00:39.92,Default,,0,0,0,,{\i1}A dospělým jsme šuma-fuk.{\i}
Dialogue: 0,0:00:40.60,0:00:42.28,Default,,0,0,0,,{\i1}Ale přesto,{\i}
Dialogue: 0,0:00:42.29,0:00:47.09,Default,,0,0,0,,{\i1}nejsme naprosto bezcenní.{\i}
Dialogue: 0,0:00:47.09,0:00:52.02,Default,,0,0,0,,{\i1}Stardust boys\Nještě mají nějakou naději!{\i}
Dialogue: 0,0:00:52.02,0:00:56.76,Default,,0,0,0,,{\i1}Víte, v nás Stardust boys...{\i}
Dialogue: 0,0:00:56.92,0:01:02.82,Default,,0,0,0,,{\i1}najdete i nějaké klady...{\i}
Dialogue: 0,0:01:04.81,0:01:09.75,Default,,0,0,0,,{\i1}Stardust boys!!!{\i}
Dialogue: 0,0:01:17.80,0:01:25.10,Default,,0,0,0,,PÁTRÁNÍ PO KRÁSNÉ PROFESORCE!
Dialogue: 0,0:01:39.01,0:01:41.47,Default,,0,0,0,,Vstupujeme do zemské atmosféry!
Dialogue: 0,0:01:41.47,0:01:43.64,Default,,0,0,0,,Měsíc mimo domov.
Dialogue: 0,0:01:43.64,0:01:44.99,Default,,0,0,0,,Úhel sestupu potvrzen!
Dialogue: 0,0:01:48.09,0:01:50.96,Default,,0,0,0,,Sklonoměry a další přístroje bez chyb.
Dialogue: 0,0:01:50.96,0:01:52.16,Default,,0,0,0,,Roger!
Dialogue: 0,0:01:52.36,0:01:54.46,Default,,0,0,0,,Přepínám na autopilota!
Dialogue: 0,0:01:56.63,0:01:58.15,Default,,0,0,0,,Tak a je to...!!
Dialogue: 0,0:02:03.91,0:02:05.82,Default,,0,0,0,,Vnitřní teplota překročila 40 °C!
Dialogue: 0,0:02:05.82,0:02:09.43,Default,,0,0,0,,Ještě poroste, procedura X!!
Dialogue: 0,0:02:09.43,0:02:11.23,Default,,0,0,0,,Procedura X!
Dialogue: 0,0:02:11.51,0:02:13.74,Default,,0,0,0,,Rychle!\NJsme v atmosféře!!
Dialogue: 0,0:02:13.74,0:02:17.20,Default,,0,0,0,,Sakra, sakra... sakra...
Dialogue: 0,0:02:17.36,0:02:21.26,Default,,0,0,0,,Zasekla se spona!
Dialogue: 0,0:02:27.09,0:02:30.78,Default,,0,0,0,,Bože...\NProcedura X tak nějak dokončena.
Dialogue: 0,0:02:30.78,0:02:32.36,Default,,0,0,0,,Cos dělal?
Dialogue: 0,0:02:32.82,0:02:33.67,Default,,0,0,0,,Co asi!
Dialogue: 0,0:02:33.67,0:02:36.00,Default,,0,0,0,,Všechno se tu rozpadá!!
Dialogue: 0,0:02:36.24,0:02:40.57,Default,,0,0,0,,Proč jen nemáme klimatizaci?!
Dialogue: 0,0:02:40.57,0:02:43.22,Default,,0,0,0,,Snad jen my máme proceduru X.
Dialogue: 0,0:02:43.28,0:02:45.91,Default,,0,0,0,,Ve skafandrech se upečeme.
Dialogue: 0,0:02:45.91,0:02:48.44,Default,,0,0,0,,Malá firma - velké problémy.
Dialogue: 0,0:02:48.84,0:02:53.44,Default,,0,0,0,,Zde vesmírná loď Střelec,\nžádáme o povolení k přistání.
Dialogue: 0,0:02:55.19,0:02:56.94,Default,,0,0,0,,Zde řídicí věž.
Dialogue: 0,0:02:56.94,0:03:00.44,Default,,0,0,0,,Vesmírné lodi Střelec,\nprosím, vyčkejte\npřibližně 30 minut.
Dialogue: 0,0:03:01.04,0:03:02.50,Default,,0,0,0,,Jakejch 30 minut?
Dialogue: 0,0:03:02.50,0:03:03.88,Default,,0,0,0,,Divné.
Dialogue: 0,0:03:03.88,0:03:06.34,Default,,0,0,0,,Nějaká nehoda?
Dialogue: 0,0:03:06.34,0:03:07.56,Default,,0,0,0,,Ha, ha, ha...
Dialogue: 0,0:03:07.56,0:03:09.04,Default,,0,0,0,,Žádná nehoda,...
Dialogue: 0,0:03:09.04,0:03:12.13,Default,,0,0,0,,...jen náme přednost!
Dialogue: 0,0:03:12.13,0:03:13.53,Default,,0,0,0,,- Cože!?\N- Cože?!
Dialogue: 0,0:03:20.60,0:03:24.03,Default,,0,0,0,,Sakra! My jsme tu byli dřív!!
Dialogue: 0,0:03:24.03,0:03:25.03,Default,,0,0,0,,Ha ha ha...
Dialogue: 0,0:03:25.03,0:03:30.34,Default,,0,0,0,,No, Space-Cosmo Service, je velký a úspěšný.\nProstě má přednost!
Dialogue: 0,0:03:30.34,0:03:31.54,Default,,0,0,0,,Jdi k čertu!
Dialogue: 0,0:03:31.54,0:03:32.72,Default,,0,0,0,,Ha, ha, ha!!!
Dialogue: 0,0:03:32.72,0:03:35.65,Default,,0,0,0,,Vracíme se z Marsu. Georafická výprava.
Dialogue: 0,0:03:35.65,0:03:37.58,Default,,0,0,0,,A co vy?
Dialogue: 0,0:03:37.98,0:03:41.06,Default,,0,0,0,,Zase čistíte na Měsíční základně záchody?
Dialogue: 0,0:03:41.06,0:03:42.60,Default,,0,0,0,,Nech toho!
Dialogue: 0,0:03:42.92,0:03:46.16,Default,,0,0,0,,Udržujeme to co jsme vybudovali!
Dialogue: 0,0:03:46.22,0:03:48.60,Default,,0,0,0,,Jasně!\nHahhaha...!
Dialogue: 0,0:03:48.60,0:03:50.82,Default,,0,0,0,,Mějte se.
Dialogue: 0,0:03:56.06,0:03:57.84,Default,,0,0,0,,Ha, ha, ha....!
Dialogue: 0,0:03:57.90,0:03:59.98,Default,,0,0,0,,Špinavcííí!!!
Dialogue: 0,0:04:01.70,0:04:02.44,Default,,0,0,0,,Sakra!
Dialogue: 0,0:04:05.70,0:04:07.96,Default,,0,0,0,,Malá firma, malé úkoly...
Dialogue: 0,0:04:08.34,0:04:10.44,Default,,0,0,0,,Instalatéřina není sranda.
Dialogue: 0,0:04:10.47,0:04:13.99,Default,,0,0,0,,Nežer se tím, už jsme na Zemi.
Dialogue: 0,0:04:14.29,0:04:14.98,Default,,0,0,0,,Co?
Dialogue: 0,0:04:14.98,0:04:16.74,Default,,0,0,0,,Annó, haló!!
Dialogue: 0,0:04:16.81,0:04:18.78,Default,,0,0,0,,Ou! Pozor!
Dialogue: 0,0:04:18.78,0:04:22.64,Default,,0,0,0,,Kampak!  Srazila ste mě!
Dialogue: 0,0:04:22.72,0:04:23.57,Default,,0,0,0,,Promiňte.
Dialogue: 0,0:04:24.17,0:04:26.21,Default,,0,0,0,,Honí mě nějaký hulvát.\NTam!
Dialogue: 0,0:04:29.51,0:04:31.06,Default,,0,0,0,,Hulvát? Co?
Dialogue: 0,0:04:32.24,0:04:33.88,Default,,0,0,0,,Tamhle ten?
Dialogue: 0,0:04:35.00,0:04:39.80,Default,,0,0,0,,Letím za snoubencem na Měsíc.
Dialogue: 0,0:04:39.94,0:04:43.52,Default,,0,0,0,,A on chce, abych si vzala jeho.
Dialogue: 0,0:04:43.88,0:04:47.10,Default,,0,0,0,,Obtěžovat zasnoubenou ženu!\NZmetek!
Dialogue: 0,0:04:48.03,0:04:49.02,Default,,0,0,0,,Dovolte.
Dialogue: 0,0:04:49.87,0:04:53.72,Default,,0,0,0,,Prosím, někoho hledám.
Dialogue: 0,0:04:53.94,0:04:54.96,Default,,0,0,0,,Koho?
Dialogue: 0,0:04:55.05,0:04:57.42,Default,,0,0,0,,Mířila někam sem.
Dialogue: 0,0:04:58.26,0:05:00.02,Default,,0,0,0,,- Grrr! Grrr!\N- Á-já...
Dialogue: 0,0:05:00.08,0:05:01.80,Default,,0,0,0,,Ne! Nekousat!!
Dialogue: 0,0:05:02.07,0:05:05.14,Default,,0,0,0,,- Grrrr!! Grrrr!\N- Á-á...
Dialogue: 0,0:05:05.44,0:05:07.02,Default,,0,0,0,,Zpátky!
Dialogue: 0,0:05:07.24,0:05:09.53,Default,,0,0,0,,Promiňte, tvor z Marsu.
Dialogue: 0,0:05:10.42,0:05:12.28,Default,,0,0,0,,- Grrrr!!\N-Á-á-á...
Dialogue: 0,0:05:12.52,0:05:14.54,Default,,0,0,0,,Dobře, mizím!
Dialogue: 0,0:05:15.52,0:05:16.98,Default,,0,0,0,,No, a je to.
Dialogue: 0,0:05:17.60,0:05:19.26,Default,,0,0,0,,Co děláš?!
Dialogue: 0,0:05:19.58,0:05:22.96,Default,,0,0,0,,Co to mělo bejt?\nJaký stvoření z Marsu?!
Dialogue: 0,0:05:23.00,0:05:24.52,Default,,0,0,0,,Klídek.
Dialogue: 0,0:05:24.88,0:05:26.74,Default,,0,0,0,,Je pryč, slečno.
Dialogue: 0,0:05:26.82,0:05:28.18,Default,,0,0,0,,Slečno?
Dialogue: 0,0:05:29.18,0:05:30.48,Default,,0,0,0,,Ach! Anno!
Dialogue: 0,0:05:30.68,0:05:33.62,Default,,0,0,0,,Anno! Počkejte!\NAnno!
Dialogue: 0,0:05:33.70,0:05:35.50,Default,,0,0,0,,Ha, Jááá!!!
Dialogue: 0,0:05:37.18,0:05:39.42,Default,,0,0,0,,Promiň, Giro.
Dialogue: 0,0:05:41.16,0:05:42.32,Default,,0,0,0,,Stůj!!
Dialogue: 0,0:05:46.56,0:05:47.85,Default,,0,0,0,,Ach!
Dialogue: 0,0:05:48.70,0:05:50.43,Default,,0,0,0,,Domov! Domov!
Dialogue: 0,0:05:50.82,0:05:52.53,Default,,0,0,0,,Hej! Jsem doma!!
Dialogue: 0,0:05:52.76,0:05:54.84,Default,,0,0,0,,Ááááá!! Táta
Dialogue: 0,0:05:54.92,0:05:56.24,Default,,0,0,0,,- Dárky!\N- Dárečky!
Dialogue: 0,0:05:56.28,0:05:59.58,Default,,0,0,0,,Klid!\NNa každého dojde!
Dialogue: 0,0:05:59.63,0:06:02.98,Default,,0,0,0,,Kameny z Měsíce.\NPodělte se!
Dialogue: 0,0:06:03.18,0:06:05.14,Default,,0,0,0,,Jéé!!\NSem, sem!
Dialogue: 0,0:06:06.10,0:06:08.16,Default,,0,0,0,,{\i1}Kde jsi byl včera?{\i0}
Dialogue: 0,0:06:09.32,0:06:11.50,Default,,0,0,0,,Ach jo,\NUž doma?
Dialogue: 0,0:06:11.58,0:06:13.90,Default,,0,0,0,,Co se děje?
Dialogue: 0,0:06:14.28,0:06:17.34,Default,,0,0,0,,Zase-s přibrala?
Dialogue: 0,0:06:18.52,0:06:19.46,Default,,0,0,0,,Ne?
Dialogue: 0,0:06:19.46,0:06:21.28,Default,,0,0,0,,{\i1}Zase půjdeš?{\i0}
Dialogue: 0,0:06:22.14,0:06:23.92,Default,,0,0,0,,Co to je?!
Dialogue: 0,0:06:27.72,0:06:29.72,Default,,0,0,0,,Nemůžu to dokoukat?
Dialogue: 0,0:06:29.72,0:06:33.64,Default,,0,0,0,,No tak, večeři, večeři!\NMám ukrutnej hlad!
Dialogue: 0,0:06:34.08,0:06:35.34,Default,,0,0,0,,A jakou?
Dialogue: 0,0:06:35.48,0:06:37.47,Default,,0,0,0,,Lazaně, mé lazaně!
Dialogue: 0,0:06:37.76,0:06:40.40,Default,,0,0,0,,Moje nejoblíbenější!
Dialogue: 0,0:06:42.76,0:06:45.34,Default,,0,0,0,,A neštvi mě!
Dialogue: 0,0:06:46.59,0:06:48.42,Default,,0,0,0,,Měsíc jen kosmický žrádlo...
Dialogue: 0,0:06:48.50,0:06:51.80,Default,,0,0,0,,...a o lazaních se mi jenom zdálo.
Dialogue: 0,0:06:52.80,0:06:53.51,Default,,0,0,0,,Co?
Dialogue: 0,0:06:53.51,0:06:56.17,Default,,0,0,0,,Smíchaná rajčata a mleté hovězí,...
Dialogue: 0,0:06:56.17,0:06:58.91,Default,,0,0,0,,...sladkokyselé mi štípá v nose,...
Dialogue: 0,0:06:58.91,0:07:00.58,Default,,0,0,0,,...ty tvý lazaně...
Dialogue: 0,0:07:00.62,0:07:02.68,Default,,0,0,0,,Kde bych vzala hovězí?!
Dialogue: 0,0:07:03.58,0:07:06.07,Default,,0,0,0,,Sakra, jak to mám vědět?!
Dialogue: 0,0:07:06.07,0:07:07.57,Default,,0,0,0,,Óó...?!
Dialogue: 0,0:07:08.04,0:07:10.16,Default,,0,0,0,,No, tak, už lazaně připrav...
Dialogue: 0,0:07:13.48,0:07:14.56,Default,,0,0,0,,Ha.
Dialogue: 0,0:07:23.88,0:07:24.72,Default,,0,0,0,,Pí...to...
Dialogue: 0,0:07:26.62,0:07:28.86,Default,,0,0,0,,Drahoušku, vítej doma!
Dialogue: 0,0:07:29.12,0:07:31.17,Default,,0,0,0,,Ne, ne, nevstávej!
Dialogue: 0,0:07:31.17,0:07:35.44,Default,,0,0,0,,Klid, klid, Pito, porod není nic\Nzvláštního, neboj se!
Dialogue: 0,0:07:35.95,0:07:37.40,Default,,0,0,0,,Ach, tady.
Dialogue: 0,0:07:37.52,0:07:38.90,Default,,0,0,0,,Nádhera.
Dialogue: 0,0:07:38.90,0:07:40.75,Default,,0,0,0,,No klid, víš...
Dialogue: 0,0:07:40.75,0:07:44.88,Default,,0,0,0,,...nejspíš to bude kluk.\NPodívej, klid, klid...
Dialogue: 0,0:07:46.53,0:07:48.08,Default,,0,0,0,,Co je?
Dialogue: 0,0:07:48.42,0:07:49.54,Default,,0,0,0,,Vzhůru nohama.
Dialogue: 0,0:07:49.99,0:07:51.30,Default,,0,0,0,,Vzhůru nohama?
Dialogue: 0,0:07:51.96,0:07:52.64,Default,,0,0,0,,Ha!
Dialogue: 0,0:07:55.24,0:07:57.37,Default,,0,0,0,,Uklidni se...
Dialogue: 0,0:07:57.37,0:08:00.30,Default,,0,0,0,,...a stejně nevíš, zda to bude kluk.
Dialogue: 0,0:08:00.34,0:08:01.42,Default,,0,0,0,,Bude!
Dialogue: 0,0:08:01.54,0:08:05.14,Default,,0,0,0,,Prokleji nebesa, když to bude holka.\NBude to kluk!
Dialogue: 0,0:08:15.68,0:08:19.28,Default,,0,0,0,,- Pospěš si, honem\N- Ano, pospěš si
Dialogue: 0,0:08:19.28,0:08:22.49,Default,,0,0,0,,- Pospěš si, honem\N- Ano, pospěš si
Dialogue: 0,0:08:22.49,0:08:26.18,Default,,0,0,0,,Pospěš si, honem
Dialogue: 0,0:08:26.18,0:08:29.32,Default,,0,0,0,,Jo, honem! Jo, honem!
Dialogue: 0,0:08:30.32,0:08:33.98,Default,,0,0,0,,- Pospěš si,\N- Jojo
Dialogue: 0,0:08:34.06,0:08:37.12,Default,,0,0,0,,Pospěš si
Dialogue: 0,0:08:37.33,0:08:41.25,Default,,0,0,0,,- A už je to tu
Dialogue: 0,0:08:41.25,0:08:44.48,Default,,0,0,0,,Pospěš si! Pospěš si, honem!
Dialogue: 0,0:08:44.48,0:08:48.20,Default,,0,0,0,,Mrňouska už nesu!
Dialogue: 0,0:08:48.35,0:08:49.46,Default,,0,0,0,,Nech to!
Dialogue: 0,0:08:49.46,0:08:53.33,Default,,0,0,0,,Drobečku, kde si tě sním
Dialogue: 0,0:08:53.44,0:08:54.34,Default,,0,0,0,,Co?
Dialogue: 0,0:08:54.76,0:08:55.88,Default,,0,0,0,,Hi, hi, hi...
Dialogue: 0,0:08:56.33,0:08:59.31,Default,,0,0,0,,Drobečku, tak pojď!
Dialogue: 0,0:08:59.31,0:09:00.46,Default,,0,0,0,,Mrňousek!
Dialogue: 0,0:09:00.61,0:09:03.42,Default,,0,0,0,,Jen si smlsnu .
Dialogue: 0,0:09:03.47,0:09:05.38,Default,,0,0,0,,Olíznu drobeček.
Dialogue: 0,0:09:05.48,0:09:07.50,Default,,0,0,0,,Vezmu ho do náruče
Dialogue: 0,0:09:07.54,0:09:11.01,Default,,0,0,0,,Tak prosím, už pojď..!
Dialogue: 0,0:09:11.78,0:09:13.39,Default,,0,0,0,,Nebuď tak netrpělivý.
Dialogue: 0,0:09:13.86,0:09:15.14,Default,,0,0,0,,To tělícko.
Dialogue: 0,0:09:15.18,0:09:17.94,Default,,0,0,0,,Napíchnu vidličkou!
Dialogue: 0,0:09:17.96,0:09:18.55,Default,,0,0,0,,Ne!
Dialogue: 0,0:09:18.55,0:09:21.83,Default,,0,0,0,,Je tak jemňoučký.
Dialogue: 0,0:09:21.92,0:09:24.86,Default,,0,0,0,,Jen slintám
Dialogue: 0,0:09:24.88,0:09:25.72,Default,,0,0,0,,Pusinku.
Dialogue: 0,0:09:25.78,0:09:33.18,Default,,0,0,0,,Láska vytryskne z hloubi srdce!
Dialogue: 0,0:09:33.68,0:09:35.90,Default,,0,0,0,,-Juchů\N- Hurá!!
Dialogue: 0,0:09:35.94,0:09:37.94,Default,,0,0,0,,Dobrou chuť!
Dialogue: 0,0:09:41.60,0:09:43.44,Default,,0,0,0,,Ach ne, právě teď?!
Dialogue: 0,0:09:46.24,0:09:48.64,Default,,0,0,0,,{\i1}Agentura\NCOSMO-SPACE{\i0}
Dialogue: 0,0:09:50.44,0:09:53.74,Default,,0,0,0,,No, děkuji za odvedenou práci,\Nale musíme jít dál.
Dialogue: 0,0:09:53.88,0:09:54.96,Default,,0,0,0,,-Ale ne!\N- Ale ne!
Dialogue: 0,0:09:55.34,0:09:59.22,Default,,0,0,0,,Ihned musíte dopravit jednu ženu\Nz Vegy Tři na Zemi.
Dialogue: 0,0:09:59.28,0:10:01.80,Default,,0,0,0,,Vega Tři? Ta je na\Ndruhým konci vesmíru!
Dialogue: 0,0:10:01.87,0:10:03.97,Default,,0,0,0,,Teď nemůžu!
Dialogue: 0,0:10:03.97,0:10:05.44,Default,,0,0,0,,Tak, nemůžeš?!
Dialogue: 0,0:10:05.53,0:10:08.58,Default,,0,0,0,,Nikoho jinýho nemám!
Dialogue: 0,0:10:08.75,0:10:11.30,Default,,0,0,0,,Nemůžu! Moje žena rodí!
Dialogue: 0,0:10:11.39,0:10:13.42,Default,,0,0,0,,Mám doma lazaně... é... ne...
Dialogue: 0,0:10:13.54,0:10:16.40,Default,,0,0,0,,Manželka mi stůně a...
Dialogue: 0,0:10:16.45,0:10:17.46,Default,,0,0,0,,Dost!
Dialogue: 0,0:10:17.60,0:10:18.66,Default,,0,0,0,,Rano,...
Dialogue: 0,0:10:18.77,0:10:22.46,Default,,0,0,0,,...lež ti kouká z očí!
Dialogue: 0,0:10:22.96,0:10:26.00,Default,,0,0,0,,Jasně. Co takhle dvojnásobek platu?
Dialogue: 0,0:10:26.10,0:10:27.38,Default,,0,0,0,,- Dvojnásobek?!\N- Dvojnásobek?!
Dialogue: 0,0:10:27.46,0:10:31.38,Default,,0,0,0,,Tak co? Ta žena se jmenuje Anna.
Dialogue: 0,0:10:36.34,0:10:37.54,Default,,0,0,0,,- Tahle?
Dialogue: 0,0:10:37.83,0:10:40.46,Default,,0,0,0,,Znáte ji? Tím lépe.
Comment: 0,0:10:40.46,0:10:44.44,Default,,0,0,0,,Dnes se vypravila na planetu Vega Tři.
Dialogue: 0,0:10:44.60,0:10:46.89,Default,,0,0,0,,Musíte ji přivést zpátky.
Dialogue: 0,0:10:46.89,0:10:48.86,Default,,0,0,0,,Na Vegu Tři?
Dialogue: 0,0:10:49.08,0:10:51.84,Default,,0,0,0,,Neletěla na Měsíc?
Dialogue: 0,0:10:51.96,0:10:52.88,Default,,0,0,0,,Nespekuluj.
Dialogue: 0,0:10:53.46,0:10:54.31,Default,,0,0,0,,To je,...
Dialogue: 0,0:10:55.01,0:10:56.14,Default,,0,0,0,,...zákazník.
Dialogue: 0,0:10:56.28,0:10:59.23,Default,,0,0,0,,Mladej, ale je asistent ve výzkumáku.
Dialogue: 0,0:10:59.23,0:11:01.23,Default,,0,0,0,,Budete poslouchat.
Dialogue: 0,0:11:01.23,0:11:02.58,Default,,0,0,0,,Prosím, jen dál!
Dialogue: 0,0:11:03.76,0:11:05.16,Default,,0,0,0,,Proboha!!
Dialogue: 0,0:11:05.48,0:11:06.42,Default,,0,0,0,,Ne!!
Dialogue: 0,0:11:06.42,0:11:08.50,Default,,0,0,0,,Ten hulvát!
Dialogue: 0,0:11:08.57,0:11:10.34,Default,,0,0,0,,Grrr!!
Dialogue: 0,0:11:10.46,0:11:12.20,Default,,0,0,0,,Stvoření z Marsu!!
Dialogue: 0,0:11:12.22,0:11:15.20,Default,,0,0,0,,Taky skočíš na každou blbost?!
Dialogue: 0,0:11:15.20,0:11:16.30,Default,,0,0,0,,Co?
Dialogue: 0,0:11:16.36,0:11:18.86,Default,,0,0,0,,Šéfe, tuhle práci neberem.
Dialogue: 0,0:11:18.96,0:11:21.30,Default,,0,0,0,,Tenhle hulvát...
Dialogue: 0,0:11:21.50,0:11:25.69,Default,,0,0,0,,...paní Annu pronásleduje!
Dialogue: 0,0:11:25.69,0:11:29.24,Default,,0,0,0,,Nepůjdem ani za dvojnásobný plat.
Dialogue: 0,0:11:29.24,0:11:30.90,Default,,0,0,0,,Mlčte!!!
Dialogue: 0,0:11:30.90,0:11:32.36,Default,,0,0,0,,Dobrá.
Dialogue: 0,0:11:32.36,0:11:35.76,Default,,0,0,0,,Vidím, že už máte dost našetřeno...
Dialogue: 0,0:11:35.86,0:11:37.52,Default,,0,0,0,,...máte, že jo?!!
Dialogue: 0,0:11:38.70,0:11:39.58,Default,,0,0,0,,- Néé,...\N- Néé,...
Dialogue: 0,0:11:39.72,0:11:43.76,Default,,0,0,0,,Takže se po těch létech rozloučíme. No?!
Dialogue: 0,0:11:43.76,0:11:45.30,Default,,0,0,0,,Ha, ha, ha, hah.
Dialogue: 0,0:11:46.00,0:11:47.73,Default,,0,0,0,,Dvě minuty do startu!
Dialogue: 0,0:11:48.58,0:11:50.45,Default,,0,0,0,,Šéf je idiot!
Dialogue: 0,0:11:50.45,0:11:52.66,Default,,0,0,0,,Kde bych sebral úspory?!
Dialogue: 0,0:11:52.66,0:11:54.13,Default,,0,0,0,,Bojím se o dítě...
Dialogue: 0,0:11:54.13,0:11:55.11,Default,,0,0,0,,Lazaně...
Dialogue: 0,0:11:55.11,0:11:56.18,Default,,0,0,0,,Hele vy!
Dialogue: 0,0:11:56.18,0:11:57.85,Default,,0,0,0,,Můžem startovat?
Dialogue: 0,0:11:57.85,0:11:58.93,Default,,0,0,0,,Spěchám!
Dialogue: 0,0:11:58.93,0:12:01.90,Default,,0,0,0,,Cože? Pospícháš za sukní?!
Dialogue: 0,0:12:01.90,0:12:02.43,Default,,0,0,0,,Tak.
Dialogue: 0,0:12:02.43,0:12:04.33,Default,,0,0,0,,Nechce se mi!!
Dialogue: 0,0:12:23.89,0:12:24.75,Default,,0,0,0,,Haló,...
Dialogue: 0,0:12:24.75,0:12:28.34,Default,,0,0,0,,...aha, haló, můj muž... prosím?
Dialogue: 0,0:12:28.40,0:12:30.43,Default,,0,0,0,,Ano, ještě nic.
Dialogue: 0,0:12:30.43,0:12:32.09,Default,,0,0,0,,Nic? Nic?
Dialogue: 0,0:12:32.09,0:12:34.69,Default,,0,0,0,,Je to v pořádku?\NNe, co se děje!
Dialogue: 0,0:12:34.69,0:12:35.82,Default,,0,0,0,,Jen klid,...
Dialogue: 0,0:12:35.82,0:12:38.14,Default,,0,0,0,,...podle doktora to jde dobře.
Dialogue: 0,0:12:38.24,0:12:40.79,Default,,0,0,0,,No, není to šarlatán...?
Dialogue: 0,0:12:40.79,0:12:43.13,Default,,0,0,0,,Zpoždění, ale ne...
Dialogue: 0,0:12:43.13,0:12:45.90,Default,,0,0,0,,Pito, prosím, položíš si sluchátko na bříško?
Dialogue: 0,0:12:45.90,0:12:47.70,Default,,0,0,0,,Proč se vykecává?
Dialogue: 0,0:12:48.62,0:12:51.85,Default,,0,0,0,,No tak, rychle, už tam je?
Dialogue: 0,0:12:51.85,0:12:52.90,Default,,0,0,0,,Co?!
Dialogue: 0,0:12:53.55,0:12:55.00,Default,,0,0,0,,Takhle?
Dialogue: 0,0:12:55.00,0:12:56.74,Default,,0,0,0,,Ahoj, mrně, slyšíš?
Dialogue: 0,0:12:56.74,0:12:58.12,Default,,0,0,0,,Ha.. hihi..
Dialogue: 0,0:12:58.12,0:12:59.05,Default,,0,0,0,,Poslouchej,...
Dialogue: 0,0:12:59.05,0:13:01.55,Default,,0,0,0,,...neber vážně,\Nkdyž říkám chci jen kluka...
Dialogue: 0,0:13:01.55,0:13:03.02,Default,,0,0,0,,...víš, no...
Dialogue: 0,0:13:03.22,0:13:04.65,Default,,0,0,0,,...jasně, žertoval jsem!!
Dialogue: 0,0:13:04.65,0:13:07.28,Default,,0,0,0,,Ach haha.. ahaha..!
Dialogue: 0,0:13:08.72,0:13:10.70,Default,,0,0,0,,Beru i holku,...
Dialogue: 0,0:13:10.78,0:13:12.68,Default,,0,0,0,,...tak jen do toho!
Dialogue: 0,0:13:14.39,0:13:16.29,Default,,0,0,0,,Jo.. ho ..ho!!
Dialogue: 0,0:13:20.49,0:13:22.23,Default,,0,0,0,,Ach...\NBojím se...
Dialogue: 0,0:13:22.63,0:13:23.83,Default,,0,0,0,,Pito, Pito...!
Dialogue: 0,0:13:24.32,0:13:25.82,Default,,0,0,0,,Tak dost!
Dialogue: 0,0:13:27.94,0:13:29.60,Default,,0,0,0,,Ach...\NBojím se...
Dialogue: 0,0:13:29.68,0:13:31.72,Default,,0,0,0,,Tohle jsou hovězí stejky?!
Dialogue: 0,0:13:31.72,0:13:34.49,Default,,0,0,0,,Zase prošlý tuby...
Dialogue: 0,0:13:34.49,0:13:37.08,Default,,0,0,0,,Lakotnej šéf!
Dialogue: 0,0:13:37.16,0:13:38.73,Default,,0,0,0,,Tak dost!
Dialogue: 0,0:13:38.73,0:13:40.63,Default,,0,0,0,,Takhle pracujete?!
Dialogue: 0,0:13:43.46,0:13:46.10,Default,,0,0,0,,Když pomyslím na moje lazaně...
Dialogue: 0,0:13:46.58,0:13:48.60,Default,,0,0,0,,Ach...\nTolik se bojím...
Dialogue: 0,0:13:48.80,0:13:51.12,Default,,0,0,0,,Stačil jsem jen přičuchnout...
Dialogue: 0,0:13:51.22,0:13:55.78,Default,,0,0,0,,Jsem jak zmlácenej pes,\nRana zmlácenej lazaněmi...
Dialogue: 0,0:13:56.97,0:13:58.63,Default,,0,0,0,,Proč já?!!
Dialogue: 0,0:13:58.94,0:14:00.16,Default,,0,0,0,,Tolik se bojím...
Dialogue: 0,0:14:00.30,0:14:01.65,Default,,0,0,0,,Zmlácenej pes...
Dialogue: 0,0:14:01.95,0:14:03.94,Default,,0,0,0,,Tolik se bojím... mé dítě...
Dialogue: 0,0:14:04.28,0:14:05.09,Default,,0,0,0,,Lazaně..
Dialogue: 0,0:14:05.36,0:14:06.14,Default,,0,0,0,,Moje dítě..
Dialogue: 0,0:14:06.44,0:14:07.29,Default,,0,0,0,,Lazaně..
Dialogue: 0,0:14:07.29,0:14:07.98,Default,,0,0,0,,Moje dítě..
Dialogue: 0,0:14:07.98,0:14:09.02,Default,,0,0,0,,Lazaně..!
Dialogue: 0,0:14:09.02,0:14:10.00,Default,,0,0,0,,Mé dítě!!!
Dialogue: 0,0:14:10.67,0:14:12.89,Default,,0,0,0,,Nevydržím to,\Nmusím si zavolat!
Dialogue: 0,0:14:12.89,0:14:14.98,Default,,0,0,0,,Chci se nacpat mými lazaněmi!!
Dialogue: 0,0:14:15.04,0:14:18.04,Default,,0,0,0,,Sakra, tak dost!!!\NTohle je výprava!!
Dialogue: 0,0:14:18.04,0:14:20.18,Default,,0,0,0,,Rychle za paní Annou!!
Dialogue: 0,0:14:20.18,0:14:21.25,Default,,0,0,0,,Mrně...
Dialogue: 0,0:14:21.25,0:14:22.51,Default,,0,0,0,,Lazaně!
Dialogue: 0,0:14:22.51,0:14:26.49,Default,,0,0,0,,Tak dost! Jeden\Njen sténá „lazaně, lazaně“...
Dialogue: 0,0:14:26.49,0:14:29.26,Default,,0,0,0,,...a druhý pořád vede absurdní telefonáty.
Dialogue: 0,0:14:29.26,0:14:30.82,Default,,0,0,0,,Jste astronauti!!
Dialogue: 0,0:14:30.82,0:14:32.02,Default,,0,0,0,,Cože?!
Dialogue: 0,0:14:32.02,0:14:34.82,Default,,0,0,0,,Jaký „absurdní telefonáty“?!
Dialogue: 0,0:14:34.94,0:14:37.84,Default,,0,0,0,,Toppyho žena bude brzo rodit!
Dialogue: 0,0:14:37.90,0:14:38.81,Default,,0,0,0,,Trochu respektu!
Dialogue: 0,0:14:38.81,0:14:41.82,Default,,0,0,0,,Já platím, tak velím!
Dialogue: 0,0:14:42.16,0:14:45.74,Default,,0,0,0,,Co mi je do vašich problémů!
Dialogue: 0,0:14:45.86,0:14:48.38,Default,,0,0,0,,Mě zajímá jen profesorka Anna!
Dialogue: 0,0:14:48.59,0:14:50.24,Default,,0,0,0,,Nejsi ubožák?
Dialogue: 0,0:14:50.24,0:14:52.99,Default,,0,0,0,,Vždyď je zasnoubená, a ty...
Dialogue: 0,0:14:52.99,0:14:55.08,Default,,0,0,0,,...ji jen pronásleduješ!\NNestydíš se?
Dialogue: 0,0:14:55.08,0:14:56.39,Default,,0,0,0,,Zasnoubená?
Dialogue: 0,0:14:56.39,0:14:57.92,Default,,0,0,0,,O co jde?
Dialogue: 0,0:14:57.92,0:15:00.15,Default,,0,0,0,,Tak dost!
Dialogue: 0,0:15:00.15,0:15:01.55,Default,,0,0,0,,Au!!
Dialogue: 0,0:15:02.84,0:15:03.50,Default,,0,0,0,,Uch!
Dialogue: 0,0:15:05.76,0:15:07.00,Default,,0,0,0,,Ach!\nMeteorit!
Dialogue: 0,0:15:07.03,0:15:08.19,Default,,0,0,0,,Sakra!
Dialogue: 0,0:15:08.19,0:15:10.09,Default,,0,0,0,,Pohon je v čudu!
Dialogue: 0,0:15:20.73,0:15:23.50,Default,,0,0,0,,Jo... nereaguje to!
Dialogue: 0,0:15:23.50,0:15:25.43,Default,,0,0,0,,Jo... to vím taky.
Dialogue: 0,0:15:25.43,0:15:27.57,Default,,0,0,0,,Jééé?
Dialogue: 0,0:15:27.57,0:15:30.78,Default,,0,0,0,,Nouzovej pohon stačí jen na Zemi.
Dialogue: 0,0:15:30.78,0:15:31.72,Default,,0,0,0,,Cože?
Dialogue: 0,0:15:31.72,0:15:33.31,Default,,0,0,0,,Ani náhodou!
Dialogue: 0,0:15:33.31,0:15:36.64,Default,,0,0,0,,Nouzový pohon nás na Vegu Tři nedostaneme.
Dialogue: 0,0:15:36.64,0:15:39.26,Default,,0,0,0,,A oprava?\NMůžete to opravit?
Dialogue: 0,0:15:39.37,0:15:42.10,Default,,0,0,0,,Spravit to jde jen zvenku.
Dialogue: 0,0:15:42.24,0:15:43.50,Default,,0,0,0,,Ale to nepůjde.
Dialogue: 0,0:15:43.50,0:15:44.91,Default,,0,0,0,,Proč ne?
Dialogue: 0,0:15:44.91,0:15:49.58,Default,,0,0,0,,Primární pohon je pěkně složitý,...
Dialogue: 0,0:15:49.58,0:15:51.63,Default,,0,0,0,,...dva na to nestačíme.
Dialogue: 0,0:15:51.63,0:15:52.27,Default,,0,0,0,,Přesně.
Dialogue: 0,0:15:52.27,0:15:53.90,Default,,0,0,0,,Pomůžu vám!
Dialogue: 0,0:15:54.00,0:15:56.57,Default,,0,0,0,,Taky můžeš umřít...
Dialogue: 0,0:15:56.57,0:15:59.24,Default,,0,0,0,,...práce venku vyžaduje kondičku.
Dialogue: 0,0:15:59.36,0:16:02.30,Default,,0,0,0,,Cos měl z těláku?
Dialogue: 0,0:16:02.34,0:16:02.82,Default,,0,0,0,,Pětku.
Dialogue: 0,0:16:02.82,0:16:03.70,Default,,0,0,0,,Cože?!
Dialogue: 0,0:16:03.70,0:16:04.60,Default,,0,0,0,,No...
Dialogue: 0,0:16:04.96,0:16:06.73,Default,,0,0,0,,Vracíme se na Zemi!
Dialogue: 0,0:16:06.73,0:16:07.62,Default,,0,0,0,,Souhlas!
Dialogue: 0,0:16:07.62,0:16:08.48,Default,,0,0,0,,Počkejte!
Dialogue: 0,0:16:09.38,0:16:11.86,Default,,0,0,0,,Lazaně už čekaj...
Dialogue: 0,0:16:11.98,0:16:12.98,Default,,0,0,0,,Nouzový pohon!
Dialogue: 0,0:16:12.98,0:16:13.55,Default,,0,0,0,,Ano!
Dialogue: 0,0:16:14.65,0:16:16.87,Default,,0,0,0,,Co sakra děláš?!
Dialogue: 0,0:16:16.87,0:16:18.15,Default,,0,0,0,,No víte...
Dialogue: 0,0:16:18.15,0:16:18.87,Default,,0,0,0,,Ehm?
Dialogue: 0,0:16:18.87,0:16:22.36,Default,,0,0,0,,Ve druhé třídě jsem měl z tělocviku čtyřku.
Dialogue: 0,0:16:22.72,0:16:24.06,Default,,0,0,0,,Čtyřku?
Dialogue: 0,0:16:24.46,0:16:28.06,Default,,0,0,0,,Musím se dostat k profesorce Anně!
Dialogue: 0,0:16:29.59,0:16:32.32,Default,,0,0,0,,Pane Giro... pročpak?
Dialogue: 0,0:16:32.42,0:16:35.00,Default,,0,0,0,,No, snad tě chápu...
Dialogue: 0,0:16:35.00,0:16:38.02,Default,,0,0,0,,...ale víš, svět je plný žen.
Dialogue: 0,0:16:38.02,0:16:40.68,Default,,0,0,0,,Vždyť paní Anna už je zadaná.
Dialogue: 0,0:16:40.68,0:16:41.42,Default,,0,0,0,,Ehm.
Dialogue: 0,0:16:41.42,0:16:44.56,Default,,0,0,0,,To je nějaké nedorozumnění.
Dialogue: 0,0:16:44.88,0:16:49.18,Default,,0,0,0,,Jaké? Řekla mám,\Nže se letí na Měsíc vdát.
Dialogue: 0,0:16:49.24,0:16:50.04,Default,,0,0,0,,Tak co?
Dialogue: 0,0:16:50.11,0:16:51.82,Default,,0,0,0,,Samé nesmysly.
Dialogue: 0,0:16:51.82,0:16:54.44,Default,,0,0,0,,V ústavu velmi těsně spolupracujeme...
Dialogue: 0,0:16:54.56,0:16:57.87,Default,,0,0,0,,...je skvělá, a já\Nsi jí velmi vážím.
Dialogue: 0,0:16:57.87,0:16:59.16,Default,,0,0,0,,Hmm?!
Dialogue: 0,0:16:59.24,0:17:02.70,Default,,0,0,0,,No, říká vám něco kontinent Mu?
Dialogue: 0,0:17:03.22,0:17:07.12,Default,,0,0,0,,To je ta pradávná\Nvelmi rozvinutá civilizace?
Dialogue: 0,0:17:07.12,0:17:08.81,Default,,0,0,0,,Správně.
Dialogue: 0,0:17:08.81,0:17:11.17,Default,,0,0,0,,Ale v ústavu řešíme jednu záhadu...
Dialogue: 0,0:17:11.17,0:17:15.04,Default,,0,0,0,,...odkud přišli budovatelé civilizace,...
Dialogue: 0,0:17:15.04,0:17:16.84,Default,,0,0,0,,...a kam zmizeli.
Dialogue: 0,0:17:22.14,0:17:25.56,Default,,0,0,0,,A jak to souvisí s profesorkou Annou?
Dialogue: 0,0:17:25.78,0:17:30.04,Default,,0,0,0,,Profesorka po tom pátrala,\Na nedávno dospěla k závěru...
Dialogue: 0,0:17:30.16,0:17:32.28,Default,,0,0,0,,...že to byli mimozemšťané.
Dialogue: 0,0:17:32.39,0:17:33.69,Default,,0,0,0,,- Mimozemšťané?\N- Mimozemšťané?
Dialogue: 0,0:17:33.69,0:17:37.81,Default,,0,0,0,,Ano, a teorii přednesla před měsícem.
Dialogue: 0,0:17:38.11,0:17:39.48,Default,,0,0,0,,{\i1}...proto,...{\i0}
Dialogue: 0,0:17:39.48,0:17:43.50,Default,,0,0,0,,{\i1}...dojdeme k závěru,\Nže mimozemský původ...{\i0}
Dialogue: 0,0:17:43.50,0:17:44.46,Default,,0,0,0,,{\i1}...potvrzuje...{\i0}
Dialogue: 0,0:17:44.46,0:17:47.91,Default,,0,0,0,,{\i1}...reliéf, nalezený v oceánu\Nmezi ruinami, který...{\i0}
Dialogue: 0,0:17:47.91,0:17:53.61,Default,,0,0,0,,{\i1}...znázorňuje galaktickou mapu. Ta přímo odkazuje...{\i0}
Dialogue: 0,0:17:54.05,0:17:55.85,Default,,0,0,0,,{\i1}...na planetu Vega Tři.{\i0}
Dialogue: 0,0:17:57.80,0:17:59.23,Default,,0,0,0,,{\i1}Tato žena,...{\i0}
Dialogue: 0,0:17:59.23,0:18:01.68,Default,,0,0,0,,{\i1}...si plete fakta s fantastickými sny...{\i0}
Dialogue: 0,0:18:01.78,0:18:04.18,Default,,0,0,0,,{\i1}Hloupost! Velká hloupost!{\i0}
Dialogue: 0,0:18:04.18,0:18:06.52,Default,,0,0,0,,{\i1}Na tohle peníze nepřidělíme.{\i0}
Dialogue: 0,0:18:06.52,0:18:08.52,Default,,0,0,0,,{\i1}Ha, ha, ha, ha, háá...{\i0}
Dialogue: 0,0:18:09.37,0:18:12.84,Default,,0,0,0,,Profesorku Annu to hluboce zasáhlo,...
Dialogue: 0,0:18:12.84,0:18:16.96,Default,,0,0,0,,...a já se bojím, že...
Dialogue: 0,0:18:16.96,0:18:22.66,Default,,0,0,0,,...odletěla na Vegu Tři,\Naby svou teorii dokázala.
Dialogue: 0,0:18:23.09,0:18:24.61,Default,,0,0,0,,Opravdu?
Dialogue: 0,0:18:24.61,0:18:25.33,Default,,0,0,0,,Ano.
Dialogue: 0,0:18:25.93,0:18:28.90,Default,,0,0,0,,A jsou Mu-ané opravdu mimozemšťané?
Dialogue: 0,0:18:28.90,0:18:30.81,Default,,0,0,0,,Jistotu nemáme, ale...
Dialogue: 0,0:18:30.84,0:18:33.06,Default,,0,0,0,,...nejdřív musíme přivést\NAnnu zpátky.
Dialogue: 0,0:18:33.22,0:18:34.12,Default,,0,0,0,,Slyšel jsem...
Dialogue: 0,0:18:34.34,0:18:36.54,Default,,0,0,0,,...pověsti z planety Vega Tři.
Dialogue: 0,0:18:36.70,0:18:39.98,Default,,0,0,0,,Jsou tam místa plná barbarů a divochů.
Dialogue: 0,0:18:41.12,0:18:42.49,Default,,0,0,0,,Prosím!
Dialogue: 0,0:18:42.89,0:18:45.39,Default,,0,0,0,,Pomohu vám s opravou pohonu!
Dialogue: 0,0:18:45.39,0:18:47.09,Default,,0,0,0,,Prosím!
Dialogue: 0,0:18:51.52,0:18:52.78,Default,,0,0,0,,Prosím vás.
Dialogue: 0,0:18:55.98,0:18:57.26,Default,,0,0,0,,Ech ee...
Dialogue: 0,0:18:58.59,0:18:59.77,Default,,0,0,0,,Rozumím,...
Dialogue: 0,0:18:59.77,0:19:01.88,Default,,0,0,0,,...probereme to.
Comment: 0,0:19:04.38,0:19:07.30,Default,,0,0,0,,Profesorko Anno...\NNajdu vás!
Dialogue: 0,0:19:08.10,0:19:11.59,Default,,0,0,0,,Fakt to vypadá na nějaké nedorozumění.
Dialogue: 0,0:19:11.59,0:19:16.00,Default,,0,0,0,,Anna nám řekla, že se\Nbude vdávat na Měsíci...
Dialogue: 0,0:19:16.17,0:19:19.57,Default,,0,0,0,,...když se s námi srazila.
Dialogue: 0,0:19:19.57,0:19:23.37,Default,,0,0,0,,Giro se o ni asi opravdu bojí.
Dialogue: 0,0:19:23.37,0:19:24.25,Default,,0,0,0,,Hmm..
Dialogue: 0,0:19:25.25,0:19:27.09,Default,,0,0,0,,A co opravy?
Dialogue: 0,0:19:27.09,0:19:28.25,Default,,0,0,0,,No co?
Dialogue: 0,0:19:28.25,0:19:29.88,Default,,0,0,0,,Nezvládne to!
Dialogue: 0,0:19:29.88,0:19:32.21,Default,,0,0,0,,Takže končíme?
Dialogue: 0,0:19:32.21,0:19:34.40,Default,,0,0,0,,A ten tělák,...
Dialogue: 0,0:19:34.40,0:19:35.76,Default,,0,0,0,,Slyšels, čtyřka.
Dialogue: 0,0:19:35.87,0:19:37.18,Default,,0,0,0,,Tak co?
Dialogue: 0,0:19:37.32,0:19:39.44,Default,,0,0,0,,Kapitán si ty.
Dialogue: 0,0:19:39.71,0:19:41.46,Default,,0,0,0,,Ty rozhodneš...
Dialogue: 0,0:19:41.60,0:19:43.13,Default,,0,0,0,,Čtyřka z těláku.
Dialogue: 0,0:19:43.13,0:19:45.06,Default,,0,0,0,,No, vím...
Dialogue: 0,0:19:45.66,0:19:47.73,Default,,0,0,0,,No!\NVsadíme na čtyřku!
Dialogue: 0,0:19:48.06,0:19:49.39,Default,,0,0,0,,Sláva.
Dialogue: 0,0:19:52.64,0:19:54.88,Default,,0,0,0,,A zvládne to čtyřka?
Dialogue: 0,0:19:55.60,0:19:56.50,Default,,0,0,0,,Rano!
Dialogue: 0,0:20:05.52,0:20:06.60,Default,,0,0,0,,Tady, páni.
Dialogue: 0,0:20:06.74,0:20:08.00,Default,,0,0,0,,Tak začnem.
Dialogue: 0,0:20:08.12,0:20:09.13,Default,,0,0,0,,Souhlas
Dialogue: 0,0:20:11.13,0:20:14.56,Default,,0,0,0,,Nastav ruce,\notoč se o 180 stupňů.
Dialogue: 0,0:20:14.65,0:20:15.35,Default,,0,0,0,,Jo!
Dialogue: 0,0:20:18.48,0:20:20.88,Default,,0,0,0,,Dobře, tak dál.
Dialogue: 0,0:20:32.30,0:20:33.47,Default,,0,0,0,,Přidržet.
Dialogue: 0,0:20:33.47,0:20:35.98,Default,,0,0,0,,Pomalu, pomalu.\nZlehka....
Dialogue: 0,0:20:35.98,0:20:37.52,Default,,0,0,0,,Pozor!!
Dialogue: 0,0:20:39.22,0:20:41.76,Default,,0,0,0,,Ale ne! Pomoc!
Dialogue: 0,0:20:41.76,0:20:43.14,Default,,0,0,0,,Giro!
Dialogue: 0,0:20:44.64,0:20:45.60,Default,,0,0,0,,Á-áááá...!
Dialogue: 0,0:20:45.60,0:20:47.90,Default,,0,0,0,,Knipl k sobě, k sobě!!
Dialogue: 0,0:20:54.48,0:20:56.22,Default,,0,0,0,,V pořádku, Giro?
Dialogue: 0,0:20:59.32,0:21:01.35,Default,,0,0,0,,Uvolnit!
Dialogue: 0,0:21:03.35,0:21:06.12,Default,,0,0,0,,Hmm... divné.\NMělo by to být OK.
Dialogue: 0,0:21:14.20,0:21:15.82,Default,,0,0,0,,No, přidej tah.
Dialogue: 0,0:21:15.84,0:21:17.34,Default,,0,0,0,,Jo. Maximum!
Dialogue: 0,0:21:28.45,0:21:30.45,Default,,0,0,0,,Hurá, hurá!!
Dialogue: 0,0:21:34.87,0:21:36.79,Default,,0,0,0,,Tady vesmírná loď Střelec.
Dialogue: 0,0:21:36.79,0:21:38.03,Default,,0,0,0,,Pito...cože?
Dialogue: 0,0:21:38.63,0:21:39.58,Default,,0,0,0,,Je na světě?!!
Dialogue: 0,0:21:39.68,0:21:41.16,Default,,0,0,0,,Kluk nebo holka?
Dialogue: 0,0:21:41.66,0:21:45.96,Default,,0,0,0,,No, na tom nezáleží,\Njen když je zdravá a normální.
Dialogue: 0,0:21:46.30,0:21:48.23,Default,,0,0,0,,Cože?\nTelefax? OK!
Dialogue: 0,0:21:48.23,0:21:49.46,Default,,0,0,0,,Tak holka, co?
Dialogue: 0,0:21:49.54,0:21:52.56,Default,,0,0,0,,Jo, posílá\Ntelefax...
Dialogue: 0,0:21:52.68,0:21:54.51,Default,,0,0,0,,...přes Spacecom.
Dialogue: 0,0:21:54.51,0:21:57.74,Default,,0,0,0,,Zde SCM.\NPříjem připraven?
Dialogue: 0,0:21:58.02,0:22:00.32,Default,,0,0,0,,Připraven, připraven, přijímáme!
Dialogue: 0,0:22:05.66,0:22:06.55,Default,,0,0,0,,Ha ha, ha...
Dialogue: 0,0:22:07.15,0:22:08.32,Default,,0,0,0,,To snad ne!!
Dialogue: 0,0:22:08.66,0:22:09.56,Default,,0,0,0,,Omlouvám se!
Dialogue: 0,0:22:09.56,0:22:12.16,Default,,0,0,0,,Interference s přenosem z Měsíční ZOO.
Dialogue: 0,0:22:12.36,0:22:13.63,Default,,0,0,0,,Uf.
Dialogue: 0,0:22:16.63,0:22:18.18,Default,,0,0,0,,Ááá.
Dialogue: 0,0:22:21.78,0:22:23.08,Default,,0,0,0,,Haha.
Dialogue: 0,0:22:23.08,0:22:26.30,Default,,0,0,0,,Víš, tímhle problémy jen začínají...\NGratuluji!
Dialogue: 0,0:22:29.84,0:22:31.34,Default,,0,0,0,,Děkuji, Rano.
Dialogue: 0,0:22:38.59,0:22:40.96,Default,,0,0,0,,Drž se.
Dialogue: 0,0:22:41.80,0:22:42.98,Default,,0,0,0,,Giro?!
Dialogue: 0,0:22:43.41,0:22:46.08,Default,,0,0,0,,No promiňte mi.
Dialogue: 0,0:22:46.08,0:22:47.00,Default,,0,0,0,,Gratuluji!
Dialogue: 0,0:22:47.00,0:22:50.06,Default,,0,0,0,,No i my se musíme omluvit...
Dialogue: 0,0:22:51.06,0:22:51.96,Default,,0,0,0,,Jasně.
Dialogue: 0,0:22:52.54,0:22:54.92,Default,,0,0,0,,Ha haha..
Dialogue: 0,0:22:55.86,0:22:57.00,Default,,0,0,0,,Tak spolu.
Dialogue: 0,0:22:57.24,0:22:58.16,Default,,0,0,0,,...spolu...
Dialogue: 0,0:22:58.40,0:22:59.26,Default,,0,0,0,,...spolu...
Dialogue: 0,0:23:00.65,0:23:02.15,Default,,0,0,0,,Ha ha hahaha..
Dialogue: 0,0:23:13.57,0:23:17.49,Default,,0,0,0,,{\i1}[Světelné roky snů]{\i0}
Dialogue: 0,0:23:18.21,0:23:21.04,Default,,0,0,0,,{\i1}V oceánu hvězdného prachu,{\i}
Dialogue: 0,0:23:21.10,0:23:24.48,Default,,0,0,0,,{\i1}proplouváš a hledáš...{\i}
Dialogue: 0,0:23:24.60,0:23:29.78,Default,,0,0,0,,{\i1}sen, v čase a prostoru{\i}
Dialogue: 0,0:23:30.82,0:23:34.22,Default,,0,0,0,,{\i1}ukryt kdesi ve světě,{\i}
Dialogue: 0,0:23:34.34,0:23:37.72,Default,,0,0,0,,{\i1}se sen skrývá v dáli,{\i}
Dialogue: 0,0:23:37.84,0:23:40.96,Default,,0,0,0,,{\i1}a ty se nevzdávej a hledej...{\i}
Dialogue: 0,0:23:41.02,0:23:44.56,Default,,0,0,0,,{\i1}sen...{\i}
Dialogue: 0,0:23:44.60,0:23:47.56,Default,,0,0,0,,{\i1}a až sen...{\i}
Dialogue: 0,0:23:47.70,0:23:51.22,Default,,0,0,0,,{\i1}...opravdu najdeš...{\i}
Dialogue: 0,0:23:51.28,0:23:54.14,Default,,0,0,0,,{\i1}Přines nám{\i}
Dialogue: 0,0:23:54.32,0:23:57.60,Default,,0,0,0,,{\i1}sem zpátky{\i}
Dialogue: 0,0:23:57.70,0:24:00.42,Default,,0,0,0,,{\i1}něco z něj!{\i}
Dialogue: 0,0:24:01.62,0:24:06.18,Default,,0,0,0,,{\i1}Přijes nám znovu radost ze snů{\i}
Dialogue: 0,0:24:06.24,0:24:20.22,Default,,0,0,0,,{\i1}Přines nám znovu štěstí ve snu{\i}
Dialogue: 0,0:24:20.64,0:24:23.34,Default,,0,0,0,,{\i1}Světelné roky snů!{\i}
