Dialogue: 0,0:01:25.10,0:01:33.04,Default,,0,0,0,,PARBALA - PRINCEZNA Z NEZNÁMÉ PLANETY
Dialogue: 0,0:01:35.03,0:01:36.73,Default,,0,0,0,,Sluneční soustava!
Dialogue: 0,0:01:37.22,0:01:39.42,Default,,0,0,0,,Ach... moje drahé lazaně!
Dialogue: 0,0:01:39.56,0:01:40.86,Default,,0,0,0,,Brzo se setkáme!
Dialogue: 0,0:01:44.28,0:01:46.07,Default,,0,0,0,,Lazaně!
Dialogue: 0,0:01:50.91,0:01:55.09,Default,,0,0,0,,Pluto mi připomíná talíř lazaní!
Dialogue: 0,0:02:01.32,0:02:02.12,Default,,0,0,0,,Živěnko...!
Dialogue: 0,0:02:02.42,0:02:04.02,Default,,0,0,0,,Brzy se setkáme!
Dialogue: 0,0:02:07.09,0:02:08.19,Default,,0,0,0,,„Táta“.....
Dialogue: 0,0:02:09.12,0:02:10.08,Default,,0,0,0,,Řekneš mi to?
Dialogue: 0,0:02:10.08,0:02:12.08,Default,,0,0,0,,Ještě mluvit nebude.
Dialogue: 0,0:02:14.48,0:02:16.18,Default,,0,0,0,,No, jasně!
Dialogue: 0,0:02:16.19,0:02:16.59,Default,,0,0,0,,Ale,...
Dialogue: 0,0:02:16.94,0:02:18.86,Default,,0,0,0,,...usměje se na mě?
Dialogue: 0,0:02:19.08,0:02:20.76,Default,,0,0,0,,Ano, usměje se na mě...
Dialogue: 0,0:02:20.76,0:02:24.26,Default,,0,0,0,,Úsměv potvrzuje lásku...
Dialogue: 0,0:02:24.89,0:02:25.58,Default,,0,0,0,,a...
Dialogue: 0,0:02:33.43,0:02:34.23,Default,,0,0,0,,Ano!
Dialogue: 0,0:02:35.06,0:02:36.76,Default,,0,0,0,,No jo prstýnek!
Dialogue: 0,0:02:36.91,0:02:37.61,Default,,0,0,0,,A...
Dialogue: 0,0:02:38.44,0:02:40.22,Default,,0,0,0,,Dort!\NJasně, dort!
Dialogue: 0,0:02:40.64,0:02:40.94,Default,,0,0,0,,Ne!
Dialogue: 0,0:02:41.26,0:02:42.76,Default,,0,0,0,,Spíš prstýnek?
Dialogue: 0,0:02:43.37,0:02:46.29,Default,,0,0,0,,Počkat, a co obřadní síň?
Dialogue: 0,0:02:46.51,0:02:50.04,Default,,0,0,0,,Na pořadí nezáleží.
Dialogue: 0,0:02:50.40,0:02:55.21,Default,,0,0,0,,A co začít volbou termínu obřadu?
Dialogue: 0,0:02:55.47,0:02:56.75,Default,,0,0,0,,Jasně!  Termín!
Dialogue: 0,0:02:56.88,0:02:58.57,Default,,0,0,0,,Giro!\NProblém!
Dialogue: 0,0:02:58.76,0:03:00.84,Default,,0,0,0,,Nezablokovala jsem termín!
Dialogue: 0,0:03:00.84,0:03:04.02,Default,,0,0,0,,Jasně! To určí i místo.
Dialogue: 0,0:03:04.02,0:03:05.92,Default,,0,0,0,,O čem mluvíš?
Dialogue: 0,0:03:05.92,0:03:07.51,Default,,0,0,0,,Akademie!
Dialogue: 0,0:03:07.51,0:03:08.31,Default,,0,0,0,,Akademie?
Dialogue: 0,0:03:08.68,0:03:09.88,Default,,0,0,0,,Bez termínu...
Dialogue: 0,0:03:10.10,0:03:12.87,Default,,0,0,0,,...se k prezentaci dostanu nejdřív za rok!
Dialogue: 0,0:03:13.29,0:03:14.29,Default,,0,0,0,,Toppy,...
Dialogue: 0,0:03:14.72,0:03:17.26,Default,,0,0,0,,...zavoláš na Zemi?
Dialogue: 0,0:03:17.48,0:03:22.18,Default,,0,0,0,,Jasně, zavolej mý ženě,\Nať mi pripraví lazaně.
Dialogue: 0,0:03:23.83,0:03:24.63,Default,,0,0,0,,Ano!
Dialogue: 0,0:03:25.05,0:03:28.41,Default,,0,0,0,,Zavolám, že táta bude brzo doma!
Dialogue: 0,0:03:33.25,0:03:34.65,Default,,0,0,0,,Co se děje?
Dialogue: 0,0:03:34.79,0:03:35.64,Default,,0,0,0,,Vypadlo to.
Dialogue: 0,0:03:35.64,0:03:36.74,Default,,0,0,0,,Ale proč?
Dialogue: 0,0:03:38.36,0:03:40.16,Default,,0,0,0,,Proč vypadl proud?!
Dialogue: 0,0:03:40.30,0:03:42.37,Default,,0,0,0,,Nouzová baterie.
Dialogue: 0,0:03:42.37,0:03:43.17,Default,,0,0,0,,Dobře!
Dialogue: 0,0:03:47.82,0:03:48.72,Default,,0,0,0,,Tady!
Dialogue: 0,0:03:48.84,0:03:50.45,Default,,0,0,0,,Unik paliva!
Dialogue: 0,0:03:50.63,0:03:51.23,Default,,0,0,0,,To ne!
Dialogue: 0,0:03:58.91,0:03:59.81,Default,,0,0,0,,Sakra!
Dialogue: 0,0:04:00.23,0:04:02.06,Default,,0,0,0,,Co se děje?!
Dialogue: 0,0:04:02.06,0:04:03.10,Default,,0,0,0,,Vypnout motory!
Dialogue: 0,0:04:03.10,0:04:03.70,Default,,0,0,0,,Roger!
Dialogue: 0,0:04:06.17,0:04:06.97,Default,,0,0,0,,Sakra!
Dialogue: 0,0:04:07.30,0:04:08.50,Default,,0,0,0,,Zlomené!
Dialogue: 0,0:04:09.31,0:04:10.33,Default,,0,0,0,,Zastav palivo!
Dialogue: 0,0:04:10.48,0:04:11.15,Default,,0,0,0,,Hej, hej!
Dialogue: 0,0:04:11.15,0:04:13.88,Default,,0,0,0,,Proč palivo?!
Dialogue: 0,0:04:16.38,0:04:20.38,Default,,0,0,0,,Giro! Palivo je hořlavý!
Dialogue: 0,0:04:32.99,0:04:34.60,Default,,0,0,0,,Pohon odstaven!
Dialogue: 0,0:04:34.60,0:04:35.91,Default,,0,0,0,,Díky bohu!
Dialogue: 0,0:04:35.92,0:04:37.18,Default,,0,0,0,,To bylo o chlup, ne?
Dialogue: 0,0:04:37.18,0:04:38.98,Default,,0,0,0,,U... už je to OK?
Dialogue: 0,0:04:39.35,0:04:40.82,Default,,0,0,0,,Už dobrý.
Dialogue: 0,0:04:40.82,0:04:41.42,Default,,0,0,0,,Jo?!
Dialogue: 0,0:04:41.47,0:04:43.46,Default,,0,0,0,,Žár motoru může...
Dialogue: 0,0:04:43.46,0:04:45.26,Default,,0,0,0,,...zapálit uniklé palivo...
Dialogue: 0,0:04:48.05,0:04:50.93,Default,,0,0,0,,Kdy poletíme dál?
Dialogue: 0,0:04:50.93,0:04:54.09,Default,,0,0,0,,Až se palivo rozptýlí.
Dialogue: 0,0:04:54.09,0:04:54.59,Default,,0,0,0,,Pak,...
Dialogue: 0,0:04:55.24,0:04:57.83,Default,,0,0,0,,...přistaneme na Plutu...
Dialogue: 0,0:04:57.83,0:05:00.17,Default,,0,0,0,,...a opravíme loď.
Dialogue: 0,0:05:00.17,0:05:02.89,Default,,0,0,0,, Kdy budeme na Zemi?
Dialogue: 0,0:05:02.89,0:05:03.59,Default,,0,0,0,,No...
Dialogue: 0,0:05:04.38,0:05:06.31,Default,,0,0,0,,..až to opravíme.
Dialogue: 0,0:05:06.31,0:05:07.18,Default,,0,0,0,,Co..?!!
Dialogue: 0,0:05:07.91,0:05:08.41,Default,,0,0,0,,Grr!
Dialogue: 0,0:05:09.07,0:05:10.60,Default,,0,0,0,,Pěknej střep!!
Dialogue: 0,0:05:10.66,0:05:13.86,Default,,0,0,0,,Vysype se, když ho potřebujeme!
Dialogue: 0,0:05:19.40,0:05:22.85,Default,,0,0,0,,"Kosmodrom Pluto"
Dialogue: 0,0:05:34.96,0:05:37.60,Default,,0,0,0,,200 Lambda\Nza opravu,
Dialogue: 0,0:05:37.60,0:05:40.90,Default,,0,0,0,,40 Lambda\Npalivo na Zemi.
Dialogue: 0,0:05:41.32,0:05:41.92,Default,,0,0,0,,Hmm...
Dialogue: 0,0:05:42.51,0:05:44.11,Default,,0,0,0,,Ehm... promiň...
Comment: 0,0:05:44.45,0:05:46.69,Default,,0,0,0,,Připočti i jídlo.
Dialogue: 0,0:05:46.69,0:05:47.99,Default,,0,0,0,,Mám hlad!
Dialogue: 0,0:05:47.99,0:05:49.19,Default,,0,0,0,,Pípo, pípo!
Dialogue: 0,0:05:49.24,0:05:49.84,Default,,0,0,0,,Ach..!!
Dialogue: 0,0:05:50.30,0:05:52.14,Default,,0,0,0,,Tak bude přednáška?
Dialogue: 0,0:05:52.14,0:05:52.54,Default,,0,0,0,,Ano.
Dialogue: 0,0:05:53.09,0:05:55.88,Default,,0,0,0,,Na zítřejší schůzi. Jediný termín.
Dialogue: 0,0:05:55.89,0:05:58.97,Default,,0,0,0,,Zítra..?\NAle Střelec nebude...
Dialogue: 0,0:05:58.97,0:06:01.46,Default,,0,0,0,,Anno, musíme jít.
Dialogue: 0,0:06:01.46,0:06:04.41,Default,,0,0,0,,Střelcem to nestihneme...
Dialogue: 0,0:06:04.59,0:06:06.38,Default,,0,0,0,,...použijeme jinou loď.
Dialogue: 0,0:06:06.48,0:06:06.98,Default,,0,0,0,,Cože??
Dialogue: 0,0:06:07.40,0:06:10.42,Default,,0,0,0,,Další loď?\NTady?.
Dialogue: 0,0:06:10.42,0:06:12.05,Default,,0,0,0,,Jo!\NTamhle!
Dialogue: 0,0:06:12.05,0:06:12.95,Default,,0,0,0,,Tady! Tady!
Dialogue: 0,0:06:14.01,0:06:14.91,Default,,0,0,0,,Ha!!!
Dialogue: 0,0:06:15.11,0:06:16.33,Default,,0,0,0,,Cosmo Servis!!
Dialogue: 0,0:06:16.33,0:06:19.52,Default,,0,0,0,,Ach, jsme připraveni.
Dialogue: 0,0:06:22.02,0:06:23.32,Default,,0,0,0,,Hele, Giro!!
Dialogue: 0,0:06:23.59,0:06:26.60,Default,,0,0,0,,To ti je jedno, čí loď použiješ?!
Dialogue: 0,0:06:26.60,0:06:29.00,Default,,0,0,0,,To teď není relevantní!
Dialogue: 0,0:06:29.20,0:06:32.26,Default,,0,0,0,,Když tam prof. nebude včas...
Dialogue: 0,0:06:32.26,0:06:35.45,Default,,0,0,0,,...tak bude čekat celý rok!
Dialogue: 0,0:06:35.45,0:06:36.75,Default,,0,0,0,,Omlouvám se,...
Dialogue: 0,0:06:36.90,0:06:42.30,Default,,0,0,0,,...ale musím tam být!
Dialogue: 0,0:06:42.34,0:06:43.54,Default,,0,0,0,,Děkuji...
Dialogue: 0,0:06:43.99,0:06:45.88,Default,,0,0,0,,...za všechno!
Dialogue: 0,0:06:50.71,0:06:51.17,Default,,0,0,0,,Anno...
Dialogue: 0,0:06:51.17,0:06:53.65,Default,,0,0,0,,No tak, Anno! Běžíme!
Dialogue: 0,0:06:53.66,0:06:54.76,Default,,0,0,0,,Tudy!
Dialogue: 0,0:06:55.36,0:06:58.26,Default,,0,0,0,,Odlétáme!
Dialogue: 0,0:06:58.64,0:06:59.34,Default,,0,0,0,,Hele...
Dialogue: 0,0:06:59.61,0:07:00.34,Default,,0,0,0,,Uvidíme se!
Dialogue: 0,0:07:00.35,0:07:01.57,Default,,0,0,0,,Profesorko, rychle!
Dialogue: 0,0:07:09.19,0:07:10.09,Default,,0,0,0,,Syčáci!
Dialogue: 0,0:07:10.79,0:07:12.54,Default,,0,0,0,,Tolik nám dluží...
Dialogue: 0,0:07:12.54,0:07:14.75,Default,,0,0,0,,A ještě ten Cosmo Service!?
Dialogue: 0,0:07:14.75,0:07:16.05,Default,,0,0,0,,Sakra!
Dialogue: 0,0:07:16.05,0:07:18.11,Default,,0,0,0,,Jsou pryč,\NRano...
Dialogue: 0,0:07:18.11,0:07:21.83,Default,,0,0,0,,Teda, Giro už je pod pantoflem...
Dialogue: 0,0:07:21.83,0:07:23.29,Default,,0,0,0,,K čertu s Akademií!
Dialogue: 0,0:07:23.29,0:07:25.17,Default,,0,0,0,,Ty ženský!
Dialogue: 0,0:07:25.17,0:07:26.37,Default,,0,0,0,,Nesnáším je!!!
Dialogue: 0,0:07:27.41,0:07:30.25,Default,,0,0,0,,Nikdy ženskou na palubě.
Dialogue: 0,0:07:30.25,0:07:31.25,Default,,0,0,0,,Ëhm...
Dialogue: 0,0:07:31.63,0:07:33.33,Default,,0,0,0,,...účet.
Dialogue: 0,0:07:34.26,0:07:37.60,Default,,0,0,0,,Platba předem.
Dialogue: 0,0:07:37.60,0:07:39.25,Default,,0,0,0,,Za opravu?
Dialogue: 0,0:07:39.26,0:07:40.47,Default,,0,0,0,,Toppy,\Nzaplať!
Dialogue: 0,0:07:42.64,0:07:43.83,Default,,0,0,0,,Ehm...!!!!!
Dialogue: 0,0:07:43.83,0:07:45.63,Default,,0,0,0,,Co se děje?
Dialogue: 0,0:07:46.67,0:07:48.14,Default,,0,0,0,,500 Lambda?
Dialogue: 0,0:07:48.76,0:07:50.56,Default,,0,0,0,,Není to moc?!
Dialogue: 0,0:07:50.75,0:07:53.95,Default,,0,0,0,,Pane, jste v turistické destinaci.
Dialogue: 0,0:07:54.11,0:07:56.75,Default,,0,0,0,,Je tu draho.
Dialogue: 0,0:07:56.75,0:07:57.54,Default,,0,0,0,,Promiňte,...
Dialogue: 0,0:07:57.60,0:07:59.69,Default,,0,0,0,,...můžeme na fakturu?
Dialogue: 0,0:07:59.69,0:08:00.46,Default,,0,0,0,,Faktura?
Dialogue: 0,0:08:01.16,0:08:02.67,Default,,0,0,0,,A firma?
Dialogue: 0,0:08:02.67,0:08:03.97,Default,,0,0,0,,Agentura Space...
Dialogue: 0,0:08:04.35,0:08:06.07,Default,,0,0,0,,No jo, ale ta zbankrotovala...
Dialogue: 0,0:08:06.07,0:08:09.27,Default,,0,0,0,,Pokud nemáte na zaplacení...
Dialogue: 0,0:08:10.96,0:08:13.71,Default,,0,0,0,,...pojďte se mnou do kanceláře!
Dialogue: 0,0:08:13.71,0:08:14.61,Default,,0,0,0,,Počkejte!
Dialogue: 0,0:08:14.61,0:08:15.71,Default,,0,0,0,,Pípo, pípo!
Dialogue: 0,0:08:16.03,0:08:17.25,Default,,0,0,0,,#$% $#%$ ?
Dialogue: 0,0:08:17.80,0:08:19.37,Default,,0,0,0,,#$% $#%$ ?
Dialogue: 0,0:08:20.07,0:08:21.91,Default,,0,0,0,,Ptá se, jestli jste ze Země.
Dialogue: 0,0:08:21.91,0:08:23.61,Default,,0,0,0,,Jsme ze Země!
Dialogue: 0,0:08:24.01,0:08:25.04,Default,,0,0,0,,#$% #$%.
Dialogue: 0,0:08:25.42,0:08:26.89,Default,,0,0,0,,#$% #$%!
Dialogue: 0,0:08:34.31,0:08:34.98,Default,,0,0,0,,Děkuji.
Dialogue: 0,0:08:39.60,0:08:40.90,Default,,0,0,0,,#$% #%$%$# %#
Dialogue: 0,0:08:41.48,0:08:43.57,Default,,0,0,0,,Říká: Najímám vás.
Dialogue: 0,0:08:43.57,0:08:44.32,Default,,0,0,0,,Práce?
Dialogue: 0,0:08:44.96,0:08:46.46,Default,,0,0,0,,A ta platba?
Dialogue: 0,0:08:46.47,0:08:48.32,Default,,0,0,0,,$#$% $#$%s
Dialogue: 0,0:08:48.75,0:08:50.15,Default,,0,0,0,,To byla záloha.
Dialogue: 0,0:08:50.15,0:08:51.35,Default,,0,0,0,,Záloha...?!
Dialogue: 0,0:08:52.08,0:08:54.73,Default,,0,0,0,,Cože? Nejde o to, že nám dali...
Dialogue: 0,0:08:54.74,0:08:55.94,Default,,0,0,0,,!"#=$('#()#"
Dialogue: 0,0:08:57.89,0:09:00.29,Default,,0,0,0,,Sibipe, co to říkal?
Dialogue: 0,0:09:00.51,0:09:03.14,Default,,0,0,0,,Lehká práce, velký plat, pípo!
Dialogue: 0,0:09:03.14,0:09:04.54,Default,,0,0,0,,Vážně?!
Dialogue: 0,0:09:04.63,0:09:06.70,Default,,0,0,0,,Není to podezřelé?
Dialogue: 0,0:09:06.70,0:09:07.20,Default,,0,0,0,,Ale..
Dialogue: 0,0:09:08.24,0:09:11.96,Default,,0,0,0,,Zaplatili tolik peněz.\NNaráz 500 Lambda...
Dialogue: 0,0:09:11.96,0:09:12.56,Default,,0,0,0,,Ale...
Dialogue: 0,0:09:13.21,0:09:14.66,Default,,0,0,0,,Rád bych viděl Živěnku.
Dialogue: 0,0:09:14.66,0:09:17.59,Default,,0,0,0,,Já bych si tak dal lazaně...
Dialogue: 0,0:09:19.24,0:09:20.74,Default,,0,0,0,,{\i1}Zprávy.{\i0}
Dialogue: 0,0:09:21.49,0:09:22.62,Default,,0,0,0,,#)(#'%")(#
Dialogue: 0,0:09:22.89,0:09:23.49,Default,,0,0,0,,Co?!
Dialogue: 0,0:09:24.01,0:09:25.16,Default,,0,0,0,,Co děláš?
Dialogue: 0,0:09:25.16,0:09:27.18,Default,,0,0,0,,- {\i1}Zpráva\NPP korespondenta.{\i0}\N- Oh, oh...
Dialogue: 0,0:09:27.18,0:09:29.66,Default,,0,0,0,,{\i1}Tajemná planeta Magrock.{\i0}
Dialogue: 0,0:09:29.76,0:09:34.38,Default,,0,0,0,,{\i1}Domnívám se, že tu v tajnosti\Nverbují pozemšťany do legií.{\i0}
Dialogue: 0,0:09:34.69,0:09:39.04,Default,,0,0,0,,{\i1}Třicet našich\Nobčanů přijalo místní nabídku,{\i0}
Dialogue: 0,0:09:39.24,0:09:43.44,Default,,0,0,0,,{\i1}ale všichni cestou zmizeli a\Nna planetě Magrock se neobjevili.{\i0}
Dialogue: 0,0:09:43.62,0:09:48.34,Default,,0,0,0,,{\i1}Prosím, dejte si pozor\Nna lukrativní nabídky.{\i0}
Dialogue: 0,0:09:56.17,0:09:57.46,Default,,0,0,0,,A jsou pryč...
Dialogue: 0,0:09:57.52,0:09:58.96,Default,,0,0,0,,...skočili nám na to.
Dialogue: 0,0:09:59.08,0:10:02.56,Default,,0,0,0,,Jinak to nejde!\NVše pro Magrock!
Dialogue: 0,0:10:03.55,0:10:05.25,Default,,0,0,0,,Planeta Magrock...
Dialogue: 0,0:10:05.30,0:10:07.69,Default,,0,0,0,,...leží na okrají Plejád,
Dialogue: 0,0:10:07.69,0:10:10.42,Default,,0,0,0,,...spolu s planetou Karemuth.
Dialogue: 0,0:10:10.42,0:10:11.32,Default,,0,0,0,,A dál?
Dialogue: 0,0:10:11.50,0:10:12.50,Default,,0,0,0,,Dál nic.
Dialogue: 0,0:10:15.67,0:10:16.77,Default,,0,0,0,,Opravdu?
Dialogue: 0,0:10:17.16,0:10:17.66,Default,,0,0,0,,Hm...
Dialogue: 0,0:10:17.88,0:10:20.73,Default,,0,0,0,,Víc toho v planetární ročence není.
Dialogue: 0,0:10:22.73,0:10:24.23,Default,,0,0,0,,Nestraš!
Dialogue: 0,0:10:25.06,0:10:27.21,Default,,0,0,0,,Je to snad civilizovaná planeta, ne?
Dialogue: 0,0:10:27.21,0:10:29.81,Default,,0,0,0,,Zaplatili dost...
Dialogue: 0,0:10:29.83,0:10:31.93,Default,,0,0,0,,Ale... je to dívné!
Dialogue: 0,0:10:32.05,0:10:33.91,Default,,0,0,0,,Nevíme, co je to za práci.
Dialogue: 0,0:10:34.29,0:10:36.76,Default,,0,0,0,,Řekli - velký plat\Nza snadnou práci!
Dialogue: 0,0:10:36.88,0:10:39.83,Default,,0,0,0,,Jo-ho-ho\Nbudu mít na lazaně...!
Dialogue: 0,0:10:53.65,0:10:56.44,Default,,0,0,0,,"Planeta Magrock"
Dialogue: 0,0:11:02.42,0:11:03.02,Default,,0,0,0,,Sakra...
Dialogue: 0,0:11:03.79,0:11:06.49,Default,,0,0,0,,Zvláštní planeta, že...?
Dialogue: 0,0:11:09.65,0:11:11.22,Default,,0,0,0,,To světlo je...
Dialogue: 0,0:11:11.22,0:11:13.32,Default,,0,0,0,,Možná čestný doprovod?
Dialogue: 0,0:11:14.64,0:11:15.24,Default,,0,0,0,,Ne...
Dialogue: 0,0:11:15.46,0:11:17.13,Default,,0,0,0,,...Co se děje,\NSibip?!
Dialogue: 0,0:11:17.13,0:11:18.14,Default,,0,0,0,,Ne...
Dialogue: 0,0:11:18.44,0:11:20.58,Default,,0,0,0,,Nepřítel přichází, pípo!
Dialogue: 0,0:11:20.76,0:11:21.28,Default,,0,0,0,,Nepřítel?!
Dialogue: 0,0:11:21.28,0:11:22.08,Default,,0,0,0,,Nepřítel!!!
Dialogue: 0,0:11:23.20,0:11:25.61,Default,,0,0,0,,Ale ne!\NNejsme ve válce...
Dialogue: 0,0:11:25.95,0:11:28.14,Default,,0,0,0,,- Musí to být doprovod!\N- Áa...a...
Dialogue: 0,0:11:28.29,0:11:28.97,Default,,0,0,0,,Rano,...
Dialogue: 0,0:11:29.31,0:11:32.31,Default,,0,0,0,,...tohle nevypadá na uvítání!
Dialogue: 0,0:11:45.39,0:11:47.59,Default,,0,0,0,,Co... co to sakra je?!
Dialogue: 0,0:11:48.12,0:11:50.12,Default,,0,0,0,,Vrací se!
Dialogue: 0,0:11:52.22,0:11:52.72,Default,,0,0,0,,Pozor!
Dialogue: 0,0:11:53.24,0:11:54.06,Default,,0,0,0,,Je po nás!
Dialogue: 0,0:11:54.06,0:11:57.56,Default,,0,0,0,,Odhoď pomocnou nádrž!
Dialogue: 0,0:12:12.94,0:12:15.04,Default,,0,0,0,,Jsou pryč.
Dialogue: 0,0:12:15.28,0:12:16.40,Default,,0,0,0,,Unikli jsme!
Dialogue: 0,0:12:16.40,0:12:18.13,Default,,0,0,0,,Díky bohu, pípo!
Dialogue: 0,0:12:18.34,0:12:21.74,Default,,0,0,0,,Možná je vyděsila rychlost Střelce!
Dialogue: 0,0:12:21.78,0:12:22.38,Default,,0,0,0,,No?
Dialogue: 0,0:12:23.61,0:12:25.91,Default,,0,0,0,,Co... co se děje?!
Dialogue: 0,0:12:26.53,0:12:28.62,Default,,0,0,0,,Rano...\N..zase uniká palivo...
Dialogue: 0,0:12:28.63,0:12:29.32,Default,,0,0,0,,Cože?!
Dialogue: 0,0:12:29.62,0:12:30.22,Default,,0,0,0,,É...\N- Ááá...
Dialogue: 0,0:12:30.86,0:12:31.42,Default,,0,0,0,,Pípo..!
Dialogue: 0,0:12:31.42,0:12:35.12,Default,,0,0,0,,Tu opravu teda zfušovali!
Dialogue: 0,0:12:51.74,0:12:54.43,Default,,0,0,0,,Tak jsme na místě!
Dialogue: 0,0:12:54.43,0:12:55.60,Default,,0,0,0,,Tohle má být...
Dialogue: 0,0:12:55.60,0:12:57.80,Default,,0,0,0,,...kosmodrom?
Dialogue: 0,0:13:01.44,0:13:02.00,Default,,0,0,0,,Ach!!
Dialogue: 0,0:13:04.48,0:13:06.17,Default,,0,0,0,,Najali nás. Jsme ze Země.
Dialogue: 0,0:13:08.24,0:13:10.64,Default,,0,0,0,,Vítejte.
Dialogue: 0,0:13:15.22,0:13:17.49,Default,,0,0,0,,Co, sakra!\NŽádná okna...?
Dialogue: 0,0:13:17.49,0:13:18.26,Default,,0,0,0,,Co se děje?
Dialogue: 0,0:13:18.30,0:13:20.85,Default,,0,0,0,,Takle jsou vybavené všechny luxusní vozy!!!
Dialogue: 0,0:13:20.85,0:13:21.95,Default,,0,0,0,,Opravdu?
Dialogue: 0,0:13:22.35,0:13:23.75,Default,,0,0,0,,Luxusní auto!!
Dialogue: 0,0:13:24.63,0:13:26.92,Default,,0,0,0,,Mám špatný pocit...!
Dialogue: 0,0:13:26.92,0:13:29.02,Default,,0,0,0,,Převáží nás luxusním autem.
Dialogue: 0,0:13:29.02,0:13:31.22,Default,,0,0,0,,Velký plat,\Nbezpochyby!
Dialogue: 0,0:13:53.77,0:13:56.84,Default,,0,0,0,,Máme se setkat s králem?
Dialogue: 0,0:14:00.30,0:14:02.08,Default,,0,0,0,,Zamkli nás.
Dialogue: 0,0:14:02.71,0:14:04.91,Default,,0,0,0,,Ale..\N..podívej!
Dialogue: 0,0:14:05.27,0:14:08.20,Default,,0,0,0,,Ty kytky budou...
Dialogue: 0,0:14:08.20,0:14:11.11,Default,,0,0,0,,...slavnostní výzdoba.
Dialogue: 0,0:14:11.11,0:14:12.11,Default,,0,0,0,,Jen doufám...
Dialogue: 0,0:14:22.94,0:14:25.52,Default,,0,0,0,,Jménem Magrocku vás vítám!
Dialogue: 0,0:14:25.52,0:14:29.60,Default,,0,0,0,,Jsem Haru,\N1427. král Magrocku.
Dialogue: 0,0:14:30.26,0:14:32.28,Default,,0,0,0,,Jsem Toppy,\Na to...
Dialogue: 0,0:14:32.28,0:14:34.71,Default,,0,0,0,,Formality přeskočíme.
Dialogue: 0,0:14:34.71,0:14:36.12,Default,,0,0,0,,Cesta vás vyčerpala.
Dialogue: 0,0:14:36.26,0:14:38.42,Default,,0,0,0,,Hned se dáme do jídla.
Dialogue: 0,0:14:39.05,0:14:40.35,Default,,0,0,0,,Och!!
Dialogue: 0,0:14:40.77,0:14:42.52,Default,,0,0,0,,Ach!!
Dialogue: 0,0:14:42.52,0:14:44.14,Default,,0,0,0,,Éé!!
Dialogue: 0,0:14:44.14,0:14:45.53,Default,,0,0,0,,Nó!!
Dialogue: 0,0:14:45.53,0:14:48.00,Default,,0,0,0,,Áá!!
Dialogue: 0,0:14:48.00,0:14:50.10,Default,,0,0,0,,Tak do jídla!
Dialogue: 0,0:14:50.16,0:14:51.33,Default,,0,0,0,,Ach, ano...
Dialogue: 0,0:14:51.62,0:14:53.42,Default,,0,0,0,,Nejdřív práce!
Dialogue: 0,0:14:56.12,0:14:57.25,Default,,0,0,0,,No tak.
Dialogue: 0,0:14:58.05,0:15:00.82,Default,,0,0,0,,Klid! Promluvíme si  při jídle.
Dialogue: 0,0:15:00.96,0:15:02.13,Default,,0,0,0,,Přesně tak!
Dialogue: 0,0:15:02.42,0:15:03.38,Default,,0,0,0,,- Ano!\N-Ááh...
Dialogue: 0,0:15:04.43,0:15:07.73,Default,,0,0,0,,Ach bože...!\NDu na to!
Dialogue: 0,0:15:32.85,0:15:35.31,Default,,0,0,0,,Kontrakt je uzavřen!
Dialogue: 0,0:15:35.31,0:15:35.91,Default,,0,0,0,,Eh..?!
Dialogue: 0,0:15:37.49,0:15:38.68,Default,,0,0,0,,Válka?!
Dialogue: 0,0:15:39.63,0:15:40.43,Default,,0,0,0,,No,...
Dialogue: 0,0:15:40.43,0:15:45.60,Default,,0,0,0,,...jsme už 30 let ve válce\Nse sousední planetou Karemuth.
Dialogue: 0,0:15:49.70,0:15:50.91,Default,,0,0,0,,Jasně...
Dialogue: 0,0:15:50.91,0:15:52.69,Default,,0,0,0,,...to to vysvětluje.
Dialogue: 0,0:15:52.80,0:15:54.37,Default,,0,0,0,,Tohle je kryt!
Dialogue: 0,0:15:54.37,0:15:59.82,Default,,0,0,0,,Ta pakáž, co nás napadla...
Dialogue: 0,0:15:59.94,0:16:01.70,Default,,0,0,0,,V poslední době,...
Dialogue: 0,0:16:01.84,0:16:05.48,Default,,0,0,0,,...naše vojenská síla upadá.
Dialogue: 0,0:16:05.54,0:16:07.75,Default,,0,0,0,,Tak... najímáte žoldnéře?!
Dialogue: 0,0:16:07.88,0:16:09.73,Default,,0,0,0,,Chcete, abychom šli do boje?!
Dialogue: 0,0:16:09.73,0:16:11.91,Default,,0,0,0,,No, žoldnéři,...
Dialogue: 0,0:16:11.91,0:16:13.22,Default,,0,0,0,,Ale ne!!
Dialogue: 0,0:16:13.40,0:16:15.70,Default,,0,0,0,,Jsme ze Země...
Dialogue: 0,0:16:15.94,0:16:19.30,Default,,0,0,0,,Za prachy nebojuju!
Dialogue: 0,0:16:19.52,0:16:22.87,Default,,0,0,0,,Ale pozemšťané udělají\Nza peníze všechno,...
Dialogue: 0,0:16:22.87,0:16:24.07,Default,,0,0,0,,...že ano?
Dialogue: 0,0:16:24.63,0:16:26.41,Default,,0,0,0,,Máš pravdu!
Dialogue: 0,0:16:26.82,0:16:28.53,Default,,0,0,0,,Ale odmítáme!!
Dialogue: 0,0:16:28.53,0:16:30.13,Default,,0,0,0,,Rana to řekl.
Dialogue: 0,0:16:30.33,0:16:32.55,Default,,0,0,0,,Do války nepůjdeme!
Dialogue: 0,0:16:32.55,0:16:33.95,Default,,0,0,0,,Proč...?
Dialogue: 0,0:16:34.56,0:16:38.44,Default,,0,0,0,,Jste tady... jsem tak zklamán...
Dialogue: 0,0:16:38.44,0:16:39.94,Default,,0,0,0,,My taky!
Dialogue: 0,0:16:41.85,0:16:43.91,Default,,0,0,0,,No, brzo se rozmyslíte!
Dialogue: 0,0:16:43.91,0:16:45.45,Default,,0,0,0,,Do speciální místnosti!
Dialogue: 0,0:16:45.45,0:16:46.43,Default,,0,0,0,,Au!
Dialogue: 0,0:16:49.31,0:16:51.01,Default,,0,0,0,,Speciální místnost, co?!
Dialogue: 0,0:16:51.18,0:16:53.80,Default,,0,0,0,,"Mimochodem, u nás se smlouva stvrzuje hostinou..."
Dialogue: 0,0:16:53.80,0:16:55.20,Default,,0,0,0,,To jo, pípo!
Dialogue: 0,0:16:55.20,0:16:59.00,Default,,0,0,0,,A není za porušení kontraktu trest smrti?
Dialogue: 0,0:16:59.40,0:17:00.36,Default,,0,0,0,,Myslíš?!
Dialogue: 0,0:17:00.36,0:17:01.16,Default,,0,0,0,,Pípopíp...
Dialogue: 0,0:17:03.27,0:17:05.97,Default,,0,0,0,,Je to tu!
Dialogue: 0,0:17:11.90,0:17:13.52,Default,,0,0,0,,Co je, paní...?
Dialogue: 0,0:17:13.59,0:17:14.43,Default,,0,0,0,,Vězení?
Dialogue: 0,0:17:14.43,0:17:17.71,Default,,0,0,0,,Takže vy... smlouvu odmítáte?
Dialogue: 0,0:17:17.71,0:17:19.11,Default,,0,0,0,,To ne!
Dialogue: 0,0:17:19.28,0:17:20.69,Default,,0,0,0,,My neválčíme!
Dialogue: 0,0:17:20.69,0:17:23.87,Default,,0,0,0,,To Karemuth začal válku!
Dialogue: 0,0:17:23.87,0:17:27.98,Default,,0,0,0,,Odvlekly Božskou hvězdu a způsobili hlad. 
Dialogue: 0,0:17:27.98,0:17:31.53,Default,,0,0,0,,Ale proč jim jídlo nedáte?
Dialogue: 0,0:17:31.53,0:17:32.83,Default,,0,0,0,,Magrock taky hladoví...
Dialogue: 0,0:17:32.83,0:17:35.56,Default,,0,0,0,,To ne! A co.\Nta hostina...
Dialogue: 0,0:17:35.56,0:17:39.58,Default,,0,0,0,,Hostina smlouvy byla\Nze zásob na celý měsíc!
Dialogue: 0,0:17:39.59,0:17:41.46,Default,,0,0,0,,- Jeden měsíc...??\N-Ach!
Dialogue: 0,0:17:42.72,0:17:43.32,Default,,0,0,0,,Ne...
Dialogue: 0,0:17:43.64,0:17:44.53,Default,,0,0,0,,Ano.
Dialogue: 0,0:17:44.81,0:17:46.69,Default,,0,0,0,,Prosím, pomozte Magrocku!
Dialogue: 0,0:17:46.81,0:17:49.07,Default,,0,0,0,,Ale... válka je...
Dialogue: 0,0:17:50.55,0:17:55.04,Default,,0,0,0,,Musíte získat Suido,\Nten může ukončit válku!
Dialogue: 0,0:17:55.44,0:17:56.25,Default,,0,0,0,,Suido?
Dialogue: 0,0:17:57.15,0:17:59.68,Default,,0,0,0,,Ne, ne,\Nzase lži!
Dialogue: 0,0:17:59.83,0:18:01.47,Default,,0,0,0,,Ne, to je pravda!
Dialogue: 0,0:18:01.80,0:18:04.67,Default,,0,0,0,,Podvedete Magrock?!
Dialogue: 0,0:18:04.81,0:18:06.41,Default,,0,0,0,,Podvedení jsme my!
Dialogue: 0,0:18:06.41,0:18:07.93,Default,,0,0,0,,Zbabělče!
Dialogue: 0,0:18:07.93,0:18:08.53,Default,,0,0,0,,Podvodníku!
Dialogue: 0,0:18:08.72,0:18:09.62,Default,,0,0,0,,Chamtivče!
Dialogue: 0,0:18:10.25,0:18:12.76,Default,,0,0,0,,Je... jen si posluž!
Dialogue: 0,0:18:13.52,0:18:15.85,Default,,0,0,0,,Prosím...\NPomozte Magrocku!
Dialogue: 0,0:18:15.85,0:18:17.71,Default,,0,0,0,,Hrozby a žadonění?
Dialogue: 0,0:18:17.71,0:18:18.39,Default,,0,0,0,,Rano!
Dialogue: 0,0:18:18.63,0:18:19.69,Default,,0,0,0,,Dobře.
Dialogue: 0,0:18:20.01,0:18:21.24,Default,,0,0,0,,Když nechcete,...
Dialogue: 0,0:18:21.37,0:18:23.42,Default,,0,0,0,,...tak táhněte!!
Dialogue: 0,0:18:23.43,0:18:27.03,Default,,0,0,0,,Jen vyžíráte naše jídlo!
Dialogue: 0,0:18:29.45,0:18:30.55,Default,,0,0,0,,No teda...
Dialogue: 0,0:18:30.55,0:18:31.64,Default,,0,0,0,,Odcházíme!
Dialogue: 0,0:18:31.64,0:18:32.63,Default,,0,0,0,,Toppy, jdeme!
Dialogue: 0,0:18:32.63,0:18:33.85,Default,,0,0,0,,Pípo, pípo!
Dialogue: 0,0:18:34.53,0:18:38.26,Default,,0,0,0,,Co, Toppy?\NTy jí věříš?!
Dialogue: 0,0:18:38.26,0:18:40.82,Default,,0,0,0,,Když zůstaneme, popraví nás.
Dialogue: 0,0:18:54.92,0:18:56.75,Default,,0,0,0,,No, mohla nám...
Dialogue: 0,0:18:57.14,0:18:58.86,Default,,0,0,0,,...říct pravdu!
Dialogue: 0,0:18:58.94,0:19:00.97,Default,,0,0,0,,Sibip také jedl...
Dialogue: 0,0:19:01.27,0:19:02.77,Default,,0,0,0,,Sibip i ty...
Dialogue: 0,0:19:02.81,0:19:03.71,Default,,0,0,0,,Je to válka!
Dialogue: 0,0:19:03.76,0:19:06.82,Default,,0,0,0,,No, když se vyhneme boji...
Dialogue: 0,0:19:07.23,0:19:10.57,Default,,0,0,0,,Ne. Lituješ - zemřeš!
Dialogue: 0,0:19:10.57,0:19:13.37,Default,,0,0,0,,%#%#, %%'##, #%#$, $#$%,....
Dialogue: 0,0:19:14.64,0:19:16.74,Default,,0,0,0,,)%#$(&&
Dialogue: 0,0:19:17.68,0:19:19.97,Default,,0,0,0,,Vyslechnout je můžeme...
Dialogue: 0,0:19:19.98,0:19:22.27,Default,,0,0,0,,A plat je v čudu...
Dialogue: 0,0:19:23.92,0:19:26.60,Default,,0,0,0,,Proč jsem to sežral...
Dialogue: 0,0:19:29.77,0:19:32.58,Default,,0,0,0,,Destička popisuje dávnou legendu...
Dialogue: 0,0:19:32.77,0:19:36.00,Default,,0,0,0,,Máme přinést Suido z Benthelemu...
Dialogue: 0,0:19:36.72,0:19:39.98,Default,,0,0,0,,„...když na Magrock udeří velká zkáza,“
Dialogue: 0,0:19:40.20,0:19:43.34,Default,,0,0,0,,„Suido nebezpečí odvrátí“.
Dialogue: 0,0:19:43.61,0:19:46.90,Default,,0,0,0,,Takže Suido je někde na Benthelemu?
Dialogue: 0,0:19:47.50,0:19:49.90,Default,,0,0,0,,Co je to Suido?
Dialogue: 0,0:19:50.91,0:19:52.64,Default,,0,0,0,,Je to skrytý poklad,...
Dialogue: 0,0:19:52.64,0:19:56.18,Default,,0,0,0,,...jediná věc,...\Nkterá ukončí dlouhou válku.
Dialogue: 0,0:19:56.18,0:19:59.53,Default,,0,0,0,,Poklad?\NSchopnost ukončit válku...
Dialogue: 0,0:20:00.16,0:20:02.42,Default,,0,0,0,,Ultimátní zbraň, co?
Dialogue: 0,0:20:02.42,0:20:04.02,Default,,0,0,0,,Jaderná zbraň?!
Dialogue: 0,0:20:05.29,0:20:09.27,Default,,0,0,0,,Nevíme, jakou moc Suido má.
Dialogue: 0,0:20:09.78,0:20:15.08,Default,,0,0,0,,Je to asi metrová červená koule.
Dialogue: 0,0:20:15.50,0:20:18.49,Default,,0,0,0,,Takže to máme přivézt.
Dialogue: 0,0:20:18.71,0:20:19.79,Default,,0,0,0,,Ale...
Dialogue: 0,0:20:19.79,0:20:22.82,Default,,0,0,0,,..proč to neuděláte sami?
Dialogue: 0,0:20:23.76,0:20:27.42,Default,,0,0,0,,Naše dospělé postihuje...
Dialogue: 0,0:20:28.51,0:20:31.76,Default,,0,0,0,,...na Bethlemu neznámá nemoc.
Dialogue: 0,0:20:31.98,0:20:34.09,Default,,0,0,0,,Odolávají pouze děti a...
Dialogue: 0,0:20:34.09,0:20:36.09,Default,,0,0,0,,...Pozemšťané, co?
Dialogue: 0,0:20:36.76,0:20:38.40,Default,,0,0,0,,Ah, tak to je?!
Dialogue: 0,0:20:38.63,0:20:41.44,Default,,0,0,0,,Pozemšťané jsou hrubí a chamtiví!
Dialogue: 0,0:20:41.44,0:20:45.51,Default,,0,0,0,,Maagrok využije naši zkaženost!
Dialogue: 0,0:20:46.39,0:20:47.28,Default,,0,0,0,,Končím!
Dialogue: 0,0:20:47.32,0:20:47.99,Default,,0,0,0,,Rano!
Dialogue: 0,0:20:49.13,0:20:51.55,Default,,0,0,0,,Toppy, je to děsivá zbraň!
Dialogue: 0,0:20:51.55,0:20:53.56,Default,,0,0,0,,Tam mě nedostaneš!
Dialogue: 0,0:20:54.01,0:20:56.22,Default,,0,0,0,,Jsem citlivější než ostatní!
Dialogue: 0,0:20:56.56,0:20:58.44,Default,,0,0,0,,Určitě se nakazím!
Dialogue: 0,0:20:58.63,0:21:02.23,Default,,0,0,0,,Pane Toppy, přijmete naši nabídku?
Dialogue: 0,0:21:02.74,0:21:03.61,Default,,0,0,0,,..No...!
Dialogue: 0,0:21:03.61,0:21:05.61,Default,,0,0,0,,Půjdu také!
Dialogue: 0,0:21:07.44,0:21:08.71,Default,,0,0,0,,Co, ty?
Dialogue: 0,0:21:08.71,0:21:10.61,Default,,0,0,0,,Drzá holka?
Dialogue: 0,0:21:10.61,0:21:12.64,Default,,0,0,0,,Moje dcera\NParbala.
Dialogue: 0,0:21:12.65,0:21:13.89,Default,,0,0,0,,Princezna...
Dialogue: 0,0:21:13.89,0:21:14.89,Default,,0,0,0,,Půjdu!
Dialogue: 0,0:21:15.36,0:21:17.92,Default,,0,0,0,,Jsem mladá, nenakazím se.
Dialogue: 0,0:21:17.93,0:21:19.33,Default,,0,0,0,,Ale Parbalo...
Dialogue: 0,0:21:19.50,0:21:21.92,Default,,0,0,0,,Neboj se, zvládnu to.
Dialogue: 0,0:21:22.06,0:21:23.02,Default,,0,0,0,,A nám...
Dialogue: 0,0:21:23.68,0:21:27.05,Default,,0,0,0,,...tu umírají lidé.
Dialogue: 0,0:21:27.56,0:21:28.98,Default,,0,0,0,,Nebudu...
Dialogue: 0,0:21:30.02,0:21:31.74,Default,,0,0,0,,...se jen dívat!
Dialogue: 0,0:21:31.84,0:21:33.75,Default,,0,0,0,,Ne... Nepůjdeš!
Dialogue: 0,0:21:34.47,0:21:36.67,Default,,0,0,0,,Nedovolím to!
Dialogue: 0,0:21:36.91,0:21:39.20,Default,,0,0,0,,Je to nebezpečné.
Dialogue: 0,0:21:39.51,0:21:40.31,Default,,0,0,0,,Půjdu!
Dialogue: 0,0:21:40.79,0:21:43.12,Default,,0,0,0,,A ani otec mi nezabrání!
Dialogue: 0,0:21:43.12,0:21:45.60,Default,,0,0,0,,Jsem rozhodnuta!
Dialogue: 0,0:21:49.07,0:21:49.87,Default,,0,0,0,,Parbalo!
Dialogue: 0,0:21:51.26,0:21:52.46,Default,,0,0,0,,Parbalo..!!!
Dialogue: 0,0:21:54.74,0:21:57.28,Default,,0,0,0,,Tak mladá...
Dialogue: 0,0:21:57.47,0:21:58.14,Default,,0,0,0,,Rano!
Dialogue: 0,0:22:03.51,0:22:05.04,Default,,0,0,0,,Půjdeš?
Dialogue: 0,0:22:05.13,0:22:05.93,Default,,0,0,0,,Dobře!
Dialogue: 0,0:22:06.41,0:22:08.11,Default,,0,0,0,,Sakra.\Půjdu!
Dialogue: 0,0:22:08.52,0:22:09.02,Default,,0,0,0,,Arch..
Dialogue: 0,0:22:09.47,0:22:11.17,Default,,0,0,0,,...určitě?!
Dialogue: 0,0:22:11.41,0:22:14.20,Default,,0,0,0,,Suido přivezeme.
Dialogue: 0,0:22:16.79,0:22:19.30,Default,,0,0,0,,Děkuji...\Nděkuji!
Dialogue: 0,0:22:19.30,0:22:20.90,Default,,0,0,0,,Díky bohu!
Dialogue: 0,0:22:21.29,0:22:24.62,Default,,0,0,0,,Tak, hned vyrazíme!
Dialogue: 0,0:22:24.79,0:22:26.20,Default,,0,0,0,,A jsem vůdce!
Dialogue: 0,0:22:27.61,0:22:31.62,Default,,0,0,0,,Jen já znám cestu!
Dialogue: 0,0:22:31.62,0:22:33.98,Default,,0,0,0,,Sakra... zase...
Dialogue: 0,0:22:34.18,0:22:36.93,Default,,0,0,0,,Zas velí ženská...!
Dialogue: 0,0:22:44.48,0:22:46.10,Default,,0,0,0,,Plnou parou!
Dialogue: 0,0:22:46.10,0:22:47.00,Default,,0,0,0,,Dobře, dobře...
Dialogue: 0,0:22:47.32,0:22:49.94,Default,,0,0,0,,Mám...\Nmám toho dost!
Dialogue: 0,0:22:49.94,0:22:50.54,Default,,0,0,0,,Ach..!!
Dialogue: 0,0:22:51.22,0:22:53.30,Default,,0,0,0,,Něco se blíží!
Dialogue: 0,0:22:55.66,0:22:57.32,Default,,0,0,0,,Bojové lodě z Karemuthu !
Dialogue: 0,0:22:57.32,0:22:59.62,Default,,0,0,0,,Ehm..!! Jsou tu zas?!
Dialogue: 0,0:22:59.62,0:23:01.12,Default,,0,0,0,,Toppy!\NCo teď!
Dialogue: 0,0:23:01.26,0:23:02.36,Default,,0,0,0,,Co teď!\NCo teď!
Dialogue: 0,0:23:02.46,0:23:04.49,Default,,0,0,0,,No, už...
Dialogue: 0,0:23:04.54,0:23:06.04,Default,,0,0,0,,..už je pozdě!
Dialogue: 0,0:23:08.31,0:23:11.28,Default,,0,0,0,,Pokračování příště
