Dialogue: Marked=0,0:07:36.43,0:07:39.27,Japanese,,0000,0000,0000,Karaoke,{\kf66}oshiri no {\kf66}chiisa {\kf20}na {\kf49}onna {\kf28}no {\kf30}ko
Dialogue: Marked=0,0:07:39.49,0:07:42.20,Japanese,,0000,0000,0000,Karaoke,{\kf69}kocchi wo {\kf68}muite {\kf20}yo {\kf76}HANII
Dialogue: Marked=0,0:07:42.74,0:07:44.28,Japanese,,0000,0000,0000,Karaoke,{\kf66}datte {\kf58}nanda {\kf28}ka
Dialogue: Marked=0,0:07:44.49,0:07:46.62,Japanese,,0000,0000,0000,Karaoke,{\kf40}datte {\kf38}datte {\kf39}nan da {\kf59}mon
Dialogue: Marked=0,0:07:48.49,0:07:54.47,Japanese,,0000,0000,0000,Karaoke,{\kf144}onegai {\kf159}onegai   {\kf180}kizutsukenai {\kf72}de
Dialogue: Marked=0,0:07:54.62,0:08:01.17,Japanese,,0000,0000,0000,Karaoke,{\kf125}watashi no {\kf94}HAATO {\kf97}wa \N  {\kf54}CHUKU {\kf54}CHUKU {\kf89}shichau {\kf129}no
Dialogue: Marked=0,0:08:01.27,0:08:03.50,Japanese,,0000,0000,0000,Karaoke,{\kf79}IYAyo {\kf79}IYAyo {\kf65}IYAyo
