Dialogue: Marked=0,0:00:36.60,0:00:39.25,*Default,NTP,0000,0000,0000,!Effect,Ach, koupel to je nádhera!
Dialogue: Marked=0,0:00:39.25,0:00:44.13,*Default,NTP,0000,0000,0000,!Effect,Cítím se tak dobře!
Dialogue: Marked=0,0:00:52.13,0:00:53.96,*Default,NTP,0000,0000,0000,!Effect,Och, strýček Utsugi!
Dialogue: Marked=0,0:00:55.27,0:00:56.43,*Default,NTP,0000,0000,0000,!Effect,Haló?
Dialogue: Marked=0,0:00:56.54,0:00:57.78,*Default,NTP,0000,0000,0000,!Effect,Ahoj, strejdo!
Dialogue: Marked=0,0:00:57.86,0:00:59.29,*Default,NTP,0000,0000,0000,!Effect,Ahoj, Honey.
Dialogue: Marked=0,0:00:59.88,0:01:02.60,*Default,NTP,0000,0000,0000,!Effect,Tak jsem konečně našel to, o čem jsem ti posledně říkal.
Dialogue: Marked=0,0:01:02.60,0:01:04.80,*Default,NTP,0000,0000,0000,!Effect,Dal mi to doktor Kisaragi...
Dialogue: Marked=0,0:01:04.81,0:01:06.03,*Default,NTP,0000,0000,0000,!Effect,Kdo jste?
Dialogue: Marked=0,0:01:06.03,0:01:06.75,*Default,NTP,0000,0000,0000,!Effect,Strýčku?
Dialogue: Marked=0,0:01:06.75,0:01:07.59,*Default,NTP,0000,0000,0000,!Effect,Co to děláte?
Dialogue: Marked=0,0:01:07.60,0:01:08.52,*Default,NTP,0000,0000,0000,!Effect,Strýčku?
Dialogue: Marked=0,0:01:08.96,0:01:10.20,*Default,NTP,0000,0000,0000,!Effect,Co se děje?
Dialogue: Marked=0,0:01:12.06,0:01:13.67,*Default,NTP,0000,0000,0000,!Effect,Nemůžu to tak nechat!
Dialogue: Marked=0,0:01:15.02,0:01:17.50,*Default,NTP,0000,0000,0000,!Effect,HONEY FLASH!
Dialogue: Marked=0,0:01:25.14,0:01:26.92,*Default,NTP,0000,0000,0000,!Effect,Ale ne!!
Dialogue: Marked=0,0:01:27.38,0:01:29.80,*Default,NTP,0000,0000,0000,!Effect,Nemám dost energie!
Dialogue: Marked=0,0:01:30.02,0:01:31.51,*Default,NTP,0000,0000,0000,!Effect,Co budu dělat?!
Dialogue: Marked=0,0:01:31.82,0:01:33.14,*Default,NTP,0000,0000,0000,!Effect,Nemám žádné šaty!
Dialogue: Marked=0,0:01:34.19,0:01:35.39,*Default,NTP,0000,0000,0000,!Effect,Tohle musím dokázat!
Dialogue: Marked=0,0:01:40.01,0:01:40.96,*Default,NTP,0000,0000,0000,!Effect,Odpadkový sáček?
Dialogue: Marked=0,0:02:00.88,0:02:02.22,*Default,NTP,0000,0000,0000,!Effect,Děkujeme vám na sto tisíc krát!
Dialogue: Marked=0,0:02:18.84,0:02:21.06,*Default,NTP,0000,0000,0000,!Effect,Dobře, břicho mám plný!
Dialogue: Marked=0,0:02:21.33,0:02:22.82,*Default,NTP,0000,0000,0000,!Effect,Teď to musí jít!
Dialogue: Marked=0,0:02:23.10,0:02:24.45,*Default,NTP,0000,0000,0000,!Effect,HONEY
Dialogue: Marked=0,0:02:24.59,0:02:25.54,*Default,NTP,0000,0000,0000,!Effect,FLASH!
Dialogue: Marked=0,0:02:45.30,0:02:47.21,*Default,NTP,0000,0000,0000,!Effect,Zpráva potvrzena...
Dialogue: Marked=0,0:02:47.21,0:02:49.74,*Default,NTP,0000,0000,0000,!Effect,Cesty k Aqualine uzavřeny...
Dialogue: Marked=0,0:02:49.74,0:02:52.92,*Default,NTP,0000,0000,0000,!Effect,Všechny jednotky mobilizovány...
Dialogue: Marked=0,0:02:57.09,0:02:58.09,*Default,NTP,0000,0000,0000,!Effect,Perfektní.
Dialogue: Marked=0,0:02:58.09,0:02:59.72,*Default,NTP,0000,0000,0000,!Effect,Jako krysa v koutě.
Dialogue: Marked=0,0:03:22.48,0:03:23.31,*Default,NTP,0000,0000,0000,!Effect,Šéfe!
Dialogue: Marked=0,0:03:23.35,0:03:24.09,*Default,NTP,0000,0000,0000,!Effect,Šéfe!
Dialogue: Marked=0,0:03:24.34,0:03:25.71,*Default,NTP,0000,0000,0000,!Effect,Hlášení!
Dialogue: Marked=0,0:03:26.83,0:03:29.23,*Default,NTP,0000,0000,0000,!Effect,Zatím je doktor Utsugi nezraněn.
Dialogue: Marked=0,0:03:29.23,0:03:30.63,*Default,NTP,0000,0000,0000,!Effect,Požadavky únosců?
Dialogue: Marked=0,0:03:30.63,0:03:32.10,*Default,NTP,0000,0000,0000,!Effect,Zatím žádné.
Dialogue: Marked=0,0:03:32.10,0:03:33.86,*Default,NTP,0000,0000,0000,!Effect,Co si ti idioti myslí?
Dialogue: Marked=0,0:03:33.86,0:03:35.25,*Default,NTP,0000,0000,0000,!Effect,Povím jim to přímo.
Dialogue: Marked=0,0:03:38.28,0:03:39.96,*Default,NTP,0000,0000,0000,!Effect,Takže zločinci poslouchejte!
Dialogue: Marked=0,0:03:39.96,0:03:42.47,*Default,NTP,0000,0000,0000,!Effect,Ihned propusťte profesora a vzdejte se!
Dialogue: Marked=0,0:03:42.47,0:03:44.51,*Default,NTP,0000,0000,0000,!Effect,Myslíte si, že uniknete?
Dialogue: Marked=0,0:03:55.62,0:03:56.94,*Default,NTP,0000,0000,0000,!Effect,Jak nudné...
Dialogue: Marked=0,0:03:57.48,0:03:59.10,*Default,NTP,0000,0000,0000,!Effect,Jen plýtváte časem.
Dialogue: Marked=0,0:03:59.15,0:03:59.85,*Default,NTP,0000,0000,0000,!Effect,Cože?
Dialogue: Marked=0,0:04:00.02,0:04:00.94,*Default,NTP,0000,0000,0000,!Effect,Neslyším vás.
Dialogue: Marked=0,0:04:02.96,0:04:04.95,*Default,NTP,0000,0000,0000,!Effect,Jste hloupá!
Dialogue: Marked=0,0:04:05.44,0:04:06.47,*Default,NTP,0000,0000,0000,!Effect,Říkám, jste hloupá!
Dialogue: Marked=0,0:04:07.12,0:04:09.79,*Default,NTP,0000,0000,0000,!Effect,Myslíte, že s tímhle porazíte Panther Claw?
Dialogue: Marked=0,0:04:09.90,0:04:11.13,*Default,NTP,0000,0000,0000,!Effect,Panther Claw?
Dialogue: Marked=0,0:04:11.77,0:04:12.84,*Default,NTP,0000,0000,0000,!Effect,Jasně!
Dialogue: Marked=0,0:04:13.00,0:04:15.14,*Default,NTP,0000,0000,0000,!Effect,Jsem jedna ze čtyř Panther Claw,
Dialogue: Marked=0,0:04:15.14,0:04:20.11,*Default,NTP,0000,0000,0000,!Effect,...a já, Gold Claw, si s vámi pohraji!
Dialogue: Marked=0,0:04:32.96,0:04:33.94,*Default,NTP,0000,0000,0000,!Effect,Šéfe!
Dialogue: Marked=0,0:04:39.47,0:04:41.57,*Default,NTP,0000,0000,0000,!Effect,Bitvu rozhodují počty a síla!
Dialogue: Marked=0,0:04:41.70,0:04:42.49,*Default,NTP,0000,0000,0000,!Effect,Pal!
Dialogue: Marked=0,0:04:53.28,0:04:56.20,*Default,NTP,0000,0000,0000,!Effect,Je pryč!
Dialogue: Marked=0,0:04:59.80,0:05:01.93,*Default,NTP,0000,0000,0000,!Effect,To bylo nebezpečné! Jste v pořádku?
Dialogue: Marked=0,0:05:03.66,0:05:04.35,*Default,NTP,0000,0000,0000,!Effect,Díky bohu!
Dialogue: Marked=0,0:05:04.35,0:05:05.32,*Default,NTP,0000,0000,0000,!Effect,Jdeme!
Dialogue: Marked=0,0:05:20.52,0:05:22.62,*Default,NTP,0000,0000,0000,!Effect,Hej, vy! Tohle nedělejte!
Dialogue: Marked=0,0:05:22.62,0:05:24.73,*Default,NTP,0000,0000,0000,!Effect,Takovouhle situaci dokáži vyřešit sama!
Dialogue: Marked=0,0:05:24.74,0:05:25.92,*Default,NTP,0000,0000,0000,!Effect,Omlouvám se!
Dialogue: Marked=0,0:05:28.80,0:05:31.42,*Default,NTP,0000,0000,0000,!Effect,Sakra! Jsou tak neodbytní!
Dialogue: Marked=0,0:05:35.94,0:05:36.92,*Default,NTP,0000,0000,0000,!Effect,Paní Gold Claw...
Dialogue: Marked=0,0:05:36.92,0:05:38.38,*Default,NTP,0000,0000,0000,!Effect,Cože?!
Dialogue: Marked=0,0:05:38.38,0:05:40.78,*Default,NTP,0000,0000,0000,!Effect,Profesor je pryč!
Dialogue: Marked=0,0:05:40.78,0:05:41.92,*Default,NTP,0000,0000,0000,!Effect,Co je to!?
Dialogue: Marked=0,0:05:44.55,0:05:45.69,*Default,NTP,0000,0000,0000,!Effect,Zrádce?!
Dialogue: Marked=0,0:05:45.69,0:05:48.24,*Default,NTP,0000,0000,0000,!Effect,Praštil mě!
Dialogue: Marked=0,0:05:48.25,0:05:49.10,*Default,NTP,0000,0000,0000,!Effect,Idiote!
Dialogue: Marked=0,0:05:53.49,0:05:54.32,*Default,NTP,0000,0000,0000,!Effect,Za ním!
Dialogue: Marked=0,0:06:01.21,0:06:02.91,*Default,NTP,0000,0000,0000,!Effect,Tam je! Našli jsme ho!
Dialogue: Marked=0,0:06:08.35,0:06:11.11,*Default,NTP,0000,0000,0000,!Effect,Paní Gold Claw, chytili jsme profesora.
Dialogue: Marked=0,0:06:12.59,0:06:14.01,*Default,NTP,0000,0000,0000,!Effect,Plýtváte mým časem!
Dialogue: Marked=0,0:06:14.13,0:06:15.34,*Default,NTP,0000,0000,0000,!Effect,Promiňte.
Dialogue: Marked=0,0:06:16.10,0:06:19.55,*Default,NTP,0000,0000,0000,!Effect,Hej vy, pancéřovaná paní a nohsledi,
Dialogue: Marked=0,0:06:19.55,0:06:21.21,*Default,NTP,0000,0000,0000,!Effect,...máme profesora tady.
Dialogue: Marked=0,0:06:21.46,0:06:23.67,*Default,NTP,0000,0000,0000,!Effect,Vzdejte se!
Dialogue: Marked=0,0:06:23.67,0:06:24.60,*Default,NTP,0000,0000,0000,!Effect,Nenechte se vysmát!
Dialogue: Marked=0,0:06:24.60,0:06:26.80,*Default,NTP,0000,0000,0000,!Effect,Melete samé nesmysly!
Dialogue: Marked=0,0:06:26.80,0:06:27.92,*Default,NTP,0000,0000,0000,!Effect,Profesor je právě tady...
Dialogue: Marked=0,0:06:29.25,0:06:31.02,*Default,NTP,0000,0000,0000,!Effect,To je profesor Utsugi!
Dialogue: Marked=0,0:06:31.39,0:06:33.06,*Default,NTP,0000,0000,0000,!Effect,Ale pak...
Dialogue: Marked=0,0:06:37.23,0:06:39.10,*Default,NTP,0000,0000,0000,!Effect,Vy! Vy nejste profesor Utsugi!
Dialogue: Marked=0,0:06:39.23,0:06:41.30,*Default,NTP,0000,0000,0000,!Effect,Pomaleji vám to zapaluje, Panther Claw.
Dialogue: Marked=0,0:06:42.39,0:06:44.04,*Default,NTP,0000,0000,0000,!Effect,HONEY FLASH!
Dialogue: Marked=0,0:07:06.15,0:07:08.03,*Default,NTP,0000,0000,0000,!Effect,Co jste zač?!
Dialogue: Marked=0,0:07:09.61,0:07:11.43,*Default,NTP,0000,0000,0000,!Effect,Napovím vám, Panther Claw.
Dialogue: Marked=0,0:07:11.99,0:07:14.18,*Default,NTP,0000,0000,0000,!Effect,Nejdříve motorkář.
Dialogue: Marked=0,0:07:14.61,0:07:17.09,*Default,NTP,0000,0000,0000,!Effect,Pak policistka,
Dialogue: Marked=0,0:07:17.09,0:07:18.97,*Default,NTP,0000,0000,0000,!Effect,...nohsled Panther Claw,
Dialogue: Marked=0,0:07:18.97,0:07:21.59,*Default,NTP,0000,0000,0000,!Effect,...a nakonec profesor Utsugi.
Dialogue: Marked=0,0:07:21.59,0:07:23.53,*Default,NTP,0000,0000,0000,!Effect,Ale má pravá totožnost je...
Dialogue: Marked=0,0:07:26.11,0:07:27.81,*Default,NTP,0000,0000,0000,!Effect,...bojovnice lásky,
Dialogue: Marked=0,0:07:28.44,0:07:29.65,*Default,NTP,0000,0000,0000,!Effect,Cutie Honey!
Dialogue: Marked=0,0:08:12.66,0:08:15.09,*Default,NTP,0000,0000,0000,!Effect,Panther Claw, nebo co to jste, připravte se!
Dialogue: Marked=0,0:08:15.09,0:08:17.56,*Default,NTP,0000,0000,0000,!Effect,S vámi to bude zábavnější!
Dialogue: Marked=0,0:09:32.09,0:09:34.61,*Default,NTP,0000,0000,0000,!Effect,To nebylo špatné, holčičko. Teď se uvidí!
Dialogue: Marked=0,0:09:34.65,0:09:35.69,*Default,NTP,0000,0000,0000,!Effect,Tak do toho!
Dialogue: Marked=0,0:09:35.78,0:09:39.00,*Default,NTP,0000,0000,0000,!Effect,GOLD ATTACK!
Dialogue: Marked=0,0:10:13.33,0:10:14.98,*Default,NTP,0000,0000,0000,!Effect,To nebylo pěkné.
Dialogue: Marked=0,0:10:17.99,0:10:19.13,*Default,NTP,0000,0000,0000,!Effect,No vidíš!
Dialogue: Marked=0,0:10:19.13,0:10:20.73,*Default,NTP,0000,0000,0000,!Effect,Co ty! Holčičko!
Dialogue: Marked=0,0:10:20.73,0:10:22.25,*Default,NTP,0000,0000,0000,!Effect,Jen si tak hrajme!
Dialogue: Marked=0,0:10:22.39,0:10:24.65,*Default,NTP,0000,0000,0000,!Effect,GOLD MISSILE!
Dialogue: Marked=0,0:10:31.86,0:10:33.48,*Default,NTP,0000,0000,0000,!Effect,Co ty!
Dialogue: Marked=0,0:11:13.51,0:11:14.41,*Default,NTP,0000,0000,0000,!Effect,Hej!?
Dialogue: Marked=0,0:11:14.75,0:11:16.00,*Default,NTP,0000,0000,0000,!Effect,Profesor....
Dialogue: Marked=0,0:11:32.91,0:11:36.80,*Default,NTP,0000,0000,0000,!Effect,Ráda bych si hrála dál, ale musím doručit tohoto muže.
Dialogue: Marked=0,0:11:37.13,0:11:38.12,*Default,NTP,0000,0000,0000,!Effect,Sbohem!
Dialogue: Marked=0,0:11:38.12,0:11:39.09,*Default,NTP,0000,0000,0000,!Effect,Holčičko!
Dialogue: Marked=0,0:11:44.75,0:11:45.68,*Default,NTP,0000,0000,0000,!Effect,Neuniknete!
Dialogue: Marked=0,0:11:45.68,0:11:48.26,*Default,NTP,0000,0000,0000,!Effect,HONEY BOOMERANG!
Dialogue: Marked=0,0:11:55.16,0:11:56.19,*Default,NTP,0000,0000,0000,!Effect,Ne!
Dialogue: Marked=0,0:11:56.43,0:11:58.67,*Default,NTP,0000,0000,0000,!Effect,Proklínám tě!
Dialogue: Marked=0,0:12:01.82,0:12:02.75,*Default,NTP,0000,0000,0000,!Effect,Strýčku!
Dialogue: Marked=0,0:12:05.75,0:12:07.65,*Default,NTP,0000,0000,0000,!Effect,Je v pořádku, jen v bezvědomí.
Dialogue: Marked=0,0:12:07.65,0:12:09.13,*Default,NTP,0000,0000,0000,!Effect,Díky bohu!
Dialogue: Marked=0,0:12:15.60,0:12:17.86,*Default,NTP,0000,0000,0000,!Effect,Sekční šéf divize Veřejné Bezpečnosti, detektiv Aki Natsuko.
Dialogue: Marked=0,0:12:18.60,0:12:20.10,*Default,NTP,0000,0000,0000,!Effect,Zatýkám vás.
Dialogue: Marked=0,0:12:21.91,0:12:24.18,*Default,NTP,0000,0000,0000,!Effect,11:22, převzata do opatrování.
Dialogue: Marked=0,0:12:24.18,0:12:27.68,*Default,NTP,0000,0000,0000,!Effect,Hmm, chybné zatčení...
Dialogue: Marked=0,0:12:29.09,0:12:29.65,*Default,NTP,0000,0000,0000,!Effect,Kdo jste?
Dialogue: Marked=0,0:12:29.65,0:12:30.32,*Default,NTP,0000,0000,0000,!Effect,Hayami Seiji.
Dialogue: Marked=0,0:12:30.32,0:12:30.78,*Default,NTP,0000,0000,0000,!Effect,Co jste zač?
Dialogue: Marked=0,0:12:30.78,0:12:31.33,*Default,NTP,0000,0000,0000,!Effect,Novinář.
Dialogue: Marked=0,0:12:31.33,0:12:34.22,*Default,NTP,0000,0000,0000,!Effect,Co tu dělá civil? A tisk nebyl pozván.
Dialogue: Marked=0,0:12:34.22,0:12:35.25,*Default,NTP,0000,0000,0000,!Effect,Ale no tak...
Dialogue: Marked=0,0:12:35.25,0:12:37.41,*Default,NTP,0000,0000,0000,!Effect,Totožnost tohoto muže je podezřelá, zatkněte ho taky.
Dialogue: Marked=0,0:12:37.41,0:12:38.22,*Default,NTP,0000,0000,0000,!Effect,Ano.
Dialogue: Marked=0,0:12:40.15,0:12:41.74,*Default,NTP,0000,0000,0000,!Effect,Nešťastná drzost...
Dialogue: Marked=0,0:12:42.23,0:12:43.45,*Default,NTP,0000,0000,0000,!Effect,Tohle není třeba.
Dialogue: Marked=0,0:12:43.45,0:12:44.97,*Default,NTP,0000,0000,0000,!Effect,Tak, vy dva půjdete se mnou.
Dialogue: Marked=0,0:12:49.40,0:12:51.09,*Default,NTP,0000,0000,0000,!Effect,Hej, chcete utéct?
Dialogue: Marked=0,0:12:51.21,0:12:51.72,*Default,NTP,0000,0000,0000,!Effect,Jo!
Dialogue: Marked=0,0:12:51.72,0:12:53.16,*Default,NTP,0000,0000,0000,!Effect,Mám zpoždění!
Dialogue: Marked=0,0:12:53.16,0:12:53.64,*Default,NTP,0000,0000,0000,!Effect,Dívejte!
Dialogue: Marked=0,0:12:54.10,0:12:55.94,*Default,NTP,0000,0000,0000,!Effect,HONEY FLASH!
Dialogue: Marked=0,0:13:06.79,0:13:07.71,*Default,NTP,0000,0000,0000,!Effect,Sakra,
Dialogue: Marked=0,0:13:07.71,0:13:08.85,*Default,NTP,0000,0000,0000,!Effect,...má jediná stopa...
Dialogue: Marked=0,0:13:09.69,0:13:13.66,*Default,NTP,0000,0000,0000,!Effect,Štěstí za mnou nepřijde
Dialogue: Marked=0,0:13:14.04,0:13:18.03,*Default,NTP,0000,0000,0000,!Effect,To já musím za ním
Dialogue: Marked=0,0:13:18.93,0:13:20.38,*Default,NTP,0000,0000,0000,!Effect,Dobré ráno!
Dialogue: Marked=0,0:13:25.85,0:13:27.02,*Default,NTP,0000,0000,0000,!Effect,Dobré ráno.
Dialogue: Marked=0,0:13:27.71,0:13:28.79,*Default,NTP,0000,0000,0000,!Effect,Dobré ráno.
Dialogue: Marked=0,0:13:29.49,0:13:30.37,*Default,NTP,0000,0000,0000,!Effect,Dobré ráno.
Dialogue: Marked=0,0:13:31.39,0:13:32.31,*Default,NTP,0000,0000,0000,!Effect,Dobré ráno.
Dialogue: Marked=0,0:13:32.79,0:13:34.43,*Default,NTP,0000,0000,0000,!Effect,Už dávno dobré ráno nebude.
Dialogue: Marked=0,0:13:34.69,0:13:36.00,*Default,NTP,0000,0000,0000,!Effect,Teď je spíš dobré poledne.
Dialogue: Marked=0,0:13:36.00,0:13:37.92,*Default,NTP,0000,0000,0000,!Effect,Ano. Dobré ráno.
Dialogue: Marked=0,0:13:38.68,0:13:40.57,*Default,NTP,0000,0000,0000,!Effect,Může s ní někdo něco udělat?
Dialogue: Marked=0,0:13:40.82,0:13:43.35,*Default,NTP,0000,0000,0000,!Effect,Nejspíš ji vyhodit nebo tak?
Dialogue: Marked=0,0:13:43.99,0:13:46.50,*Default,NTP,0000,0000,0000,!Effect,Ti dnešní mladí...
Dialogue: Marked=0,0:13:47.25,0:13:49.30,*Default,NTP,0000,0000,0000,!Effect,Taková nezodpovědnost.
Dialogue: Marked=0,0:14:14.82,0:14:16.45,*Default,NTP,0000,0000,0000,!Effect,Slečno Kisaragi...
Dialogue: Marked=0,0:14:16.45,0:14:19.29,*Default,NTP,0000,0000,0000,!Effect,Ano? Promiňte! Hned pomohu!
Dialogue: Marked=0,0:14:19.33,0:14:21.88,*Default,NTP,0000,0000,0000,!Effect,Nemůžete toho nechat a začít pracovat?
Dialogue: Marked=0,0:14:21.88,0:14:22.39,*Default,NTP,0000,0000,0000,!Effect,Ano!
Dialogue: Marked=0,0:14:22.40,0:14:23.90,*Default,NTP,0000,0000,0000,!Effect,No tak, rozneste čaj.
Dialogue: Marked=0,0:14:23.90,0:14:25.24,*Default,NTP,0000,0000,0000,!Effect,Ano, hned!
Dialogue: Marked=0,0:14:29.86,0:14:33.12,*Default,NTP,0000,0000,0000,!Effect,Podívejme... komu nejdřív...
Dialogue: Marked=0,0:14:41.18,0:14:43.14,*Default,NTP,0000,0000,0000,!Effect,Tady, váš čaj.
Dialogue: Marked=0,0:14:50.76,0:14:51.72,*Default,NTP,0000,0000,0000,!Effect,Tady.
Dialogue: Marked=0,0:14:56.08,0:14:57.12,*Default,NTP,0000,0000,0000,!Effect,Hotovo!
Dialogue: Marked=0,0:14:57.12,0:14:59.97,*Default,NTP,0000,0000,0000,!Effect,Bože, vy jste neužitečná!
Dialogue: Marked=0,0:15:01.02,0:15:03.61,*Default,NTP,0000,0000,0000,!Effect,Poslouchejte, první šéf.
Dialogue: Marked=0,0:15:03.61,0:15:04.61,*Default,NTP,0000,0000,0000,!Effect,Pak jeho asistent.
Dialogue: Marked=0,0:15:05.29,0:15:06.41,*Default,NTP,0000,0000,0000,!Effect,Potom hlavní supervizor.
Dialogue: Marked=0,0:15:06.41,0:15:07.41,*Default,NTP,0000,0000,0000,!Effect,A jeho asistent.
Dialogue: Marked=0,0:15:07.71,0:15:09.47,*Default,NTP,0000,0000,0000,!Effect,Pak náš supervizor.
Dialogue: Marked=0,0:15:09.47,0:15:11.05,*Default,NTP,0000,0000,0000,!Effect,A zbývající starší.
Dialogue: Marked=0,0:15:11.05,0:15:14.20,*Default,NTP,0000,0000,0000,!Effect,Kdy se tohle konečně naučíte?
Dialogue: Marked=0,0:15:14.20,0:15:17.33,*Default,NTP,0000,0000,0000,!Effect,Ale já myslela, že takhle to potěší všechny.
Dialogue: Marked=0,0:15:17.33,0:15:19.45,*Default,NTP,0000,0000,0000,!Effect,Nejste hloupá? Jak si myslíte, že jste stará?
Dialogue: Marked=0,0:15:19.45,0:15:21.42,*Default,NTP,0000,0000,0000,!Effect,No, už je to rok od mého znovuzrození.
Dialogue: Marked=0,0:15:21.42,0:15:23.55,*Default,NTP,0000,0000,0000,!Effect,Cože? To je nějak divné.
Dialogue: Marked=0,0:15:23.55,0:15:26.37,*Default,NTP,0000,0000,0000,!Effect,Hlavní supervizore, myslím, že by měla být propuštěna.
Dialogue: Marked=0,0:15:29.82,0:15:32.37,*Default,NTP,0000,0000,0000,!Effect,Očekáváte, že vám to uvěříme?
Dialogue: Marked=0,0:15:32.37,0:15:33.99,*Default,NTP,0000,0000,0000,!Effect,Ale to jsou fakta.
Dialogue: Marked=0,0:15:33.99,0:15:35.46,*Default,NTP,0000,0000,0000,!Effect,Prosím, přečtěte si mou zprávu.
Dialogue: Marked=0,0:15:35.46,0:15:37.22,*Default,NTP,0000,0000,0000,!Effect,Pravda je taková,
Dialogue: Marked=0,0:15:37.75,0:15:39.70,*Default,NTP,0000,0000,0000,!Effect,...že tokijská Aqualine byla těžce poškozena.
Dialogue: Marked=0,0:15:39.70,0:15:40.70,*Default,NTP,0000,0000,0000,!Effect,Opravy budou značné.
Dialogue: Marked=0,0:15:41.07,0:15:42.84,*Default,NTP,0000,0000,0000,!Effect,A zodpovědní zločinci nejsou uvězněni.
Dialogue: Marked=0,0:15:42.84,0:15:44.12,*Default,NTP,0000,0000,0000,!Effect,Nemáme jen jedno vedení.
Dialogue: Marked=0,0:15:44.12,0:15:46.08,*Default,NTP,0000,0000,0000,!Effect,Teď jsme v hluboké nemilosti!
Dialogue: Marked=0,0:15:46.08,0:15:48.15,*Default,NTP,0000,0000,0000,!Effect,Jsme pod stálým tlakem.
Dialogue: Marked=0,0:15:48.24,0:15:51.31,*Default,NTP,0000,0000,0000,!Effect,Sériové únosy krásných žen neustávají a média mají žně.
Dialogue: Marked=0,0:15:52.76,0:15:54.37,*Default,NTP,0000,0000,0000,!Effect,Bolí mne hlava, jen na to pomyslím.
Dialogue: Marked=0,0:16:01.40,0:16:02.56,*Default,NTP,0000,0000,0000,!Effect,Perfektní.
Dialogue: Marked=0,0:16:06.94,0:16:08.13,*Default,NTP,0000,0000,0000,!Effect,Šéfe, kafe?
Dialogue: Marked=0,0:16:08.44,0:16:09.25,*Default,NTP,0000,0000,0000,!Effect,Nepotřebuji.
Dialogue: Marked=0,0:16:10.94,0:16:12.12,*Default,NTP,0000,0000,0000,!Effect,Hm, co můžu...
Dialogue: Marked=0,0:16:12.12,0:16:13.85,*Default,NTP,0000,0000,0000,!Effect,Jen počkejte na další příkazy.
Dialogue: Marked=0,0:16:13.89,0:16:15.09,*Default,NTP,0000,0000,0000,!Effect,{\i1\a6}Slečno Kisaragi, počítám s vámi. Tady máte pět onigiri. Děkuji!{\i0}
Dialogue: Marked=0,0:16:14.10,0:16:19.58,*Default,NTP,0000,0000,0000,!Effect,Sakra, to už jsem začala pracovat jen za onigiri?
Dialogue: Marked=0,0:16:16.47,0:16:17.86,*Default,NTP,0000,0000,0000,!Effect,{\i1\a9}Děkuji, tady máte tři onigiri jako dar.{\i0}
Dialogue: Marked=0,0:16:16.47,0:16:17.86,*Default,NTP,0000,0000,0000,!Effect,{\i1\a11}Slečno Kisaragi, potřebuji 7/14, prosím. Tady jsou tři onigiri a...{\i0}
Dialogue: Marked=0,0:16:20.58,0:16:21.55,*Default,NTP,0000,0000,0000,!Effect,Ale...
Dialogue: Marked=0,0:16:21.55,0:16:22.99,*Default,NTP,0000,0000,0000,!Effect,Miluju onigiri.
Dialogue: Marked=0,0:16:22.99,0:16:24.53,*Default,NTP,0000,0000,0000,!Effect,Takže to bude v pořádku!
Dialogue: Marked=0,0:16:27.50,0:16:29.82,*Default,NTP,0000,0000,0000,!Effect,Dobrá práce!
Dialogue: Marked=0,0:16:29.82,0:16:31.29,*Default,NTP,0000,0000,0000,!Effect,Kam půjdete na večeři?
Dialogue: Marked=0,0:16:31.29,0:16:34.24,*Default,NTP,0000,0000,0000,!Effect,Zase chytit film?
Dialogue: Marked=0,0:16:40.13,0:16:44.42,*Default,NTP,0000,0000,0000,!Effect,Ach jo, všichni se tak maj. Taky bych chtěla jít ven a hrát si.
Dialogue: Marked=0,0:16:44.42,0:16:46.18,*Default,NTP,0000,0000,0000,!Effect,Ale ty víš...
Dialogue: Marked=0,0:16:46.18,0:16:49.88,*Default,NTP,0000,0000,0000,!Effect,Musím dodělat dnešní práci.
Dialogue: Marked=0,0:17:02.54,0:17:05.40,*Default,NTP,0000,0000,0000,!Effect,Zase přesčas?
Dialogue: Marked=0,0:17:05.40,0:17:08.09,*Default,NTP,0000,0000,0000,!Effect,Jo. Nemůžu jim s tím seknout, když mi dávají onigiri.
Dialogue: Marked=0,0:17:08.09,0:17:10.30,*Default,NTP,0000,0000,0000,!Effect,I takhle pozdě v noci, co?
Dialogue: Marked=0,0:17:10.30,0:17:11.18,*Default,NTP,0000,0000,0000,!Effect,Jo.
Dialogue: Marked=0,0:17:11.18,0:17:12.13,*Default,NTP,0000,0000,0000,!Effect,Tady máš.
Dialogue: Marked=0,0:17:12.13,0:17:14.54,*Default,NTP,0000,0000,0000,!Effect,Ach! Děkuji jako vždycky!
Dialogue: Marked=0,0:17:18.93,0:17:21.06,*Default,NTP,0000,0000,0000,!Effect,Mm, lahoda!
Dialogue: Marked=0,0:17:21.06,0:17:23.22,*Default,NTP,0000,0000,0000,!Effect,Tetičko, ty vaše domácí jsou vždycky nejlepší!
Dialogue: Marked=0,0:17:25.85,0:17:30.69,*Default,NTP,0000,0000,0000,!Effect,Hele, pomohu vám tetičko.
Dialogue: Marked=0,0:17:30.69,0:17:31.71,*Default,NTP,0000,0000,0000,!Effect,Pomůžeš mi?
Dialogue: Marked=0,0:17:31.71,0:17:32.94,*Default,NTP,0000,0000,0000,!Effect,Díky!
Dialogue: Marked=0,0:17:37.31,0:17:38.79,*Default,NTP,0000,0000,0000,!Effect,Dobré ráno, číčo!
Dialogue: Marked=0,0:17:38.79,0:17:40.77,*Default,NTP,0000,0000,0000,!Effect,Zas jsi dneska přišla!
Dialogue: Marked=0,0:17:40.77,0:17:43.63,*Default,NTP,0000,0000,0000,!Effect,Hej, hej, posloucháš?
Dialogue: Marked=0,0:17:43.63,0:17:46.97,*Default,NTP,0000,0000,0000,!Effect,Ach ano, musím zavolat strýčka.
Dialogue: Marked=0,0:17:49.48,0:17:56.73,*Default,NTP,0000,0000,0000,!Effect,Haló, profesor Utsugi je v současnosti nedostupný. Nyní je u Panther Claw.
Dialogue: Marked=0,0:17:56.73,0:18:01.63,*Default,NTP,0000,0000,0000,!Effect,Pokud mu něco potřebujete, sdělte nám to a zavěste.
Dialogue: Marked=0,0:18:01.63,0:18:02.87,*Default,NTP,0000,0000,0000,!Effect,Cože?!
Dialogue: Marked=0,0:18:02.87,0:18:03.80,*Default,NTP,0000,0000,0000,!Effect,Co je to?!
Dialogue: Marked=0,0:18:06.10,0:18:07.75,*Default,NTP,0000,0000,0000,!Effect,Vzali nám ho rovnou pod nosem.
Dialogue: Marked=0,0:18:07.75,0:18:10.58,*Default,NTP,0000,0000,0000,!Effect,Proto nemohu nechávat věci na ostatních.
Dialogue: Marked=0,0:18:10.58,0:18:12.27,*Default,NTP,0000,0000,0000,!Effect,Slečna Aki Natsuko....
Dialogue: Marked=0,0:18:12.27,0:18:16.15,*Default,NTP,0000,0000,0000,!Effect,Hmm, potřebuji nějaké stopy!
Dialogue: Marked=0,0:18:17.35,0:18:18.62,*Default,NTP,0000,0000,0000,!Effect,Jdeme!
Dialogue: Marked=0,0:18:21.58,0:18:23.82,*Default,NTP,0000,0000,0000,!Effect,Kisaragi! Kde je Kisaragi?
Dialogue: Marked=0,0:18:23.82,0:18:27.59,*Default,NTP,0000,0000,0000,!Effect,Není tu. Vypadá to, že zase přijde pozdě.
Dialogue: Marked=0,0:18:27.60,0:18:31.30,*Default,NTP,0000,0000,0000,!Effect,Zase?! Co to s ní je?!
Dialogue: Marked=0,0:18:31.79,0:18:34.46,*Default,NTP,0000,0000,0000,!Effect,Sekční šéf divize Veřejné Bezpečnosti, detektiv Aki Natsuko.
Dialogue: Marked=0,0:18:35.24,0:18:36.96,*Default,NTP,0000,0000,0000,!Effect,Nečekejte, že vás pustím.
Dialogue: Marked=0,0:18:36.97,0:18:40.52,*Default,NTP,0000,0000,0000,!Effect,Nechci, aby na mne přišli shora jako na vás.
Dialogue: Marked=0,0:18:44.19,0:18:45.61,*Default,NTP,0000,0000,0000,!Effect,Ach, šéfe!
Dialogue: Marked=0,0:18:45.61,0:18:48.31,*Default,NTP,0000,0000,0000,!Effect,Můžete to podepsat?
Dialogue: Marked=0,0:18:48.31,0:18:52.24,*Default,NTP,0000,0000,0000,!Effect,Ach, právě to chci. Dejte mi tu vyhlášku.
Dialogue: Marked=0,0:18:52.24,0:18:55.36,*Default,NTP,0000,0000,0000,!Effect,Co? Právě teď...
Dialogue: Marked=0,0:18:55.36,0:18:56.42,*Default,NTP,0000,0000,0000,!Effect,Cože?
Dialogue: Marked=0,0:18:56.42,0:18:57.06,*Default,NTP,0000,0000,0000,!Effect,Důkaz?
Dialogue: Marked=0,0:18:57.06,0:18:58.36,*Default,NTP,0000,0000,0000,!Effect,Co po mě chcete?
Dialogue: Marked=0,0:18:58.37,0:19:00.06,*Default,NTP,0000,0000,0000,!Effect,Nevím nic.
Dialogue: Marked=0,0:19:00.06,0:19:01.19,*Default,NTP,0000,0000,0000,!Effect,Vzdejte to!
Dialogue: Marked=0,0:19:15.61,0:19:19.01,*Default,NTP,0000,0000,0000,!Effect,A já si myslela, že policie bude mít alespoň nějakou stopu.
Dialogue: Marked=0,0:19:19.78,0:19:21.73,*Default,NTP,0000,0000,0000,!Effect,Vidím, že máte maličké potíže,
Dialogue: Marked=0,0:19:21.73,0:19:23.12,*Default,NTP,0000,0000,0000,!Effect,...slečinko.
Dialogue: Marked=0,0:19:23.12,0:19:25.07,*Default,NTP,0000,0000,0000,!Effect,Hele, vy jste ten muž!
Dialogue: Marked=0,0:19:25.07,0:19:26.31,*Default,NTP,0000,0000,0000,!Effect,Za tamto vám děkuji.
Dialogue: Marked=0,0:19:26.31,0:19:30.30,*Default,NTP,0000,0000,0000,!Effect,Promiňte, představím se sám. Novinář, Hayami Seiji.
Dialogue: Marked=0,0:19:30.30,0:19:30.86,*Default,NTP,0000,0000,0000,!Effect,Rád vás potkávám.
Dialogue: Marked=0,0:19:30.86,0:19:32.43,*Default,NTP,0000,0000,0000,!Effect,N... nápodobně.
Dialogue: Marked=0,0:19:34.27,0:19:38.12,*Default,NTP,0000,0000,0000,!Effect,Hmm, jste daleko roztomilejší, než jsem slyšel.
Dialogue: Marked=0,0:19:38.12,0:19:40.36,*Default,NTP,0000,0000,0000,!Effect,Jméno Cutie Honey je více než přiměřené!
Dialogue: Marked=0,0:19:40.36,0:19:41.45,*Default,NTP,0000,0000,0000,!Effect,Ach, ne, ne, ne!
Dialogue: Marked=0,0:19:41.45,0:19:43.25,*Default,NTP,0000,0000,0000,!Effect,Nepotřebujete použít I Systém.
Dialogue: Marked=0,0:19:43.25,0:19:44.25,*Default,NTP,0000,0000,0000,!Effect,Jak o tom víte?
Dialogue: Marked=0,0:19:44.25,0:19:47.97,*Default,NTP,0000,0000,0000,!Effect,Živí mne to. Hledat pravdu je má práce.
Dialogue: Marked=0,0:19:47.97,0:19:49.56,*Default,NTP,0000,0000,0000,!Effect,Proč jste tady?
Dialogue: Marked=0,0:19:49.56,0:19:51.04,*Default,NTP,0000,0000,0000,!Effect,Povím vám o několika stopách.
Dialogue: Marked=0,0:19:51.04,0:19:52.32,*Default,NTP,0000,0000,0000,!Effect,Proč?
Dialogue: Marked=0,0:19:52.32,0:19:54.41,*Default,NTP,0000,0000,0000,!Effect,Protože jsem na vaší straně!
Dialogue: Marked=0,0:19:54.42,0:19:55.81,*Default,NTP,0000,0000,0000,!Effect,Na mé straně?
Dialogue: Marked=0,0:19:55.81,0:19:59.38,*Default,NTP,0000,0000,0000,!Effect,Ti vojáci co jste porazila záhadně zmizeli.
Dialogue: Marked=0,0:19:59.38,0:20:02.18,*Default,NTP,0000,0000,0000,!Effect,A jejich schopnosti, jak jsme viděli, přesahují lidské.
Dialogue: Marked=0,0:20:02.18,0:20:05.53,*Default,NTP,0000,0000,0000,!Effect,Bylo to způsobené nanostroji injektovanými do jejich těl.
Dialogue: Marked=0,0:20:05.54,0:20:07.38,*Default,NTP,0000,0000,0000,!Effect,Musíte o tom něco vědět.
Dialogue: Marked=0,0:20:07.38,0:20:10.93,*Default,NTP,0000,0000,0000,!Effect,No, určitě jsem o nějakém systému slyšela.
Dialogue: Marked=0,0:20:11.60,0:20:12.98,*Default,NTP,0000,0000,0000,!Effect,To je...
Dialogue: Marked=0,0:20:12.98,0:20:14.37,*Default,NTP,0000,0000,0000,!Effect,To je pravda!
Dialogue: Marked=0,0:20:14.37,0:20:18.57,*Default,NTP,0000,0000,0000,!Effect,Váš otec, profesor Kisaragi prováděl přesně takové výzkumy.
Dialogue: Marked=0,0:20:18.57,0:20:19.57,*Default,NTP,0000,0000,0000,!Effect,Je to stejné jako UI systém.
Dialogue: Marked=0,0:20:19.57,0:20:23.35,*Default,NTP,0000,0000,0000,!Effect,Tak to může být to, po čem Panther Claw...
Dialogue: Marked=0,0:20:23.35,0:20:24.84,*Default,NTP,0000,0000,0000,!Effect,Přesně.
Dialogue: Marked=0,0:20:24.84,0:20:31.30,*Default,NTP,0000,0000,0000,!Effect,Technologie, kterou profesor Kisaragi vyvíjel, a únos profesora Utsugiho, který ve výzkumech pokračoval...
Dialogue: Marked=0,0:20:31.30,0:20:35.21,*Default,NTP,0000,0000,0000,!Effect,Proto byl můj otec zabit? A teď strýček Utsugi?
Dialogue: Marked=0,0:20:35.21,0:20:37.26,*Default,NTP,0000,0000,0000,!Effect,Takže...
Dialogue: Marked=0,0:20:37.27,0:20:38.40,*Default,NTP,0000,0000,0000,!Effect,...chcete vědět víc?
Dialogue: Marked=0,0:20:38.40,0:20:39.82,*Default,NTP,0000,0000,0000,!Effect,Ano, chci!
Dialogue: Marked=0,0:20:39.82,0:20:42.77,*Default,NTP,0000,0000,0000,!Effect,No, tak to uděláme obchodní dohodu.
Dialogue: Marked=0,0:20:42.77,0:20:44.57,*Default,NTP,0000,0000,0000,!Effect,A co to bylo do teď?
Dialogue: Marked=0,0:20:44.57,0:20:46.71,*Default,NTP,0000,0000,0000,!Effect,Mé poděkování.
Dialogue: Marked=0,0:20:46.71,0:20:47.82,*Default,NTP,0000,0000,0000,!Effect,Jakou obchodní dohodu?
Dialogue: Marked=0,0:20:47.82,0:20:50.14,*Default,NTP,0000,0000,0000,!Effect,Exkluzívní interview.
Dialogue: Marked=0,0:20:50.14,0:20:51.59,*Default,NTP,0000,0000,0000,!Effect,To je má podmínka.
Dialogue: Marked=0,0:20:51.59,0:20:54.37,*Default,NTP,0000,0000,0000,!Effect,No jistě, taky se ráda na něco zeptám.
Dialogue: Marked=0,0:20:55.14,0:21:00.24,*Default,NTP,0000,0000,0000,!Effect,Ach, bože. Jak víte, že nikdy žádné ženě nic neodmítnu, Nat-chan?
Dialogue: Marked=0,0:21:00.24,0:21:01.52,*Default,NTP,0000,0000,0000,!Effect,Nat-chan?!
Dialogue: Marked=0,0:21:02.23,0:21:04.40,*Default,NTP,0000,0000,0000,!Effect,Ach, to je Nat-chan!
Dialogue: Marked=0,0:21:04.40,0:21:06.45,*Default,NTP,0000,0000,0000,!Effect,Nat-chan! Nat-chan!
Dialogue: Marked=0,0:21:07.30,0:21:10.54,*Default,NTP,0000,0000,0000,!Effect,Zločinci mají tajnou organizaci - Panther Claw.
Dialogue: Marked=0,0:21:10.80,0:21:15.63,*Default,NTP,0000,0000,0000,!Effect,A tihle lidé udělají cokoli, jen aby uspokojili své tužby.
Dialogue: Marked=0,0:21:15.63,0:21:17.32,*Default,NTP,0000,0000,0000,!Effect,Jsou extrémně sobečtí.
Dialogue: Marked=0,0:21:17.32,0:21:21.22,*Default,NTP,0000,0000,0000,!Effect,A do svých těl integrovali spousty zbraní.
Dialogue: Marked=0,0:21:21.22,0:21:23.86,*Default,NTP,0000,0000,0000,!Effect,Vlastní skupinu neuvěřitelných vojáků.
Dialogue: Marked=0,0:21:23.86,0:21:26.91,*Default,NTP,0000,0000,0000,!Effect,Tak to je tajná organizace Panther Claw?
Dialogue: Marked=0,0:21:26.91,0:21:29.09,*Default,NTP,0000,0000,0000,!Effect,Kdo je vůdce?
Dialogue: Marked=0,0:21:29.09,0:21:31.86,*Default,NTP,0000,0000,0000,!Effect,Říká si Sestra Jill.
Dialogue: Marked=0,0:21:32.96,0:21:34.36,*Default,NTP,0000,0000,0000,!Effect,Sestra Jill....
Dialogue: Marked=0,0:22:49.86,0:22:53.20,*Default,NTP,0000,0000,0000,!Effect,Už je to dlouhý čas, Paní Sestro Jill.
Dialogue: Marked=0,0:22:53.20,0:22:56.51,*Default,NTP,0000,0000,0000,!Effect,Návratem od Panthera Zory,
Dialogue: Marked=0,0:22:56.51,0:22:59.76,*Default,NTP,0000,0000,0000,!Effect,...jsem hluboce poctěn.
Dialogue: Marked=0,0:23:01.88,0:23:03.52,*Default,NTP,0000,0000,0000,!Effect,Cože? Půjdete sama?
Dialogue: Marked=0,0:23:03.52,0:23:06.66,*Default,NTP,0000,0000,0000,!Effect,Jistě! To je práce pro policii.
Dialogue: Marked=0,0:23:06.66,0:23:08.94,*Default,NTP,0000,0000,0000,!Effect,Dobře, hodím vás na základnu.
Dialogue: Marked=0,0:23:08.94,0:23:09.60,*Default,NTP,0000,0000,0000,!Effect,Projdu se.
Dialogue: Marked=0,0:23:09.60,0:23:11.59,*Default,NTP,0000,0000,0000,!Effect,Základem pátrání je práce nohou.
Dialogue: Marked=0,0:23:11.59,0:23:13.53,*Default,NTP,0000,0000,0000,!Effect,Nat-chan, budu pracovat s tebou!
Dialogue: Marked=0,0:23:13.53,0:23:14.14,*Default,NTP,0000,0000,0000,!Effect,Nepotřebuji.
Dialogue: Marked=0,0:23:14.15,0:23:15.51,*Default,NTP,0000,0000,0000,!Effect,Říkám, budu pracovat s tebou!
Dialogue: Marked=0,0:23:15.51,0:23:16.51,*Default,NTP,0000,0000,0000,!Effect,Otravo.
Dialogue: Marked=0,0:23:16.51,0:23:17.51,*Default,NTP,0000,0000,0000,!Effect,Zlá.
Dialogue: Marked=0,0:23:25.24,0:23:26.62,*Default,NTP,0000,0000,0000,!Effect,Takže, jedeme.
Dialogue: Marked=0,0:23:28.84,0:23:31.25,*Default,NTP,0000,0000,0000,!Effect,Jediná věc se kterou můžeme počítat, je systém.
Dialogue: Marked=0,0:23:32.06,0:23:34.14,*Default,NTP,0000,0000,0000,!Effect,Dobře, pokračujeme v plánu.
Dialogue: Marked=0,0:23:40.47,0:23:44.64,*Default,NTP,0000,0000,0000,!Effect,Už je to dlouho, Paní Sestro Jill.
Dialogue: Marked=0,0:23:44.64,0:23:47.31,*Default,NTP,0000,0000,0000,!Effect,S potěšením dosvědčuji vaši krásu.
Dialogue: Marked=0,0:23:47.32,0:23:51.05,*Default,NTP,0000,0000,0000,!Effect,Je to vaše dvoutisící dvě stě dvaadvacáté probuzení.
Dialogue: Marked=0,0:23:51.05,0:23:53.00,*Default,NTP,0000,0000,0000,!Effect,Skromně vám darujeme...
Dialogue: Marked=0,0:23:53.00,0:23:56.13,*Default,NTP,0000,0000,0000,!Effect,...své neutuchající služby.
Dialogue: Marked=0,0:24:02.75,0:24:03.72,*Default,NTP,0000,0000,0000,!Effect,Black Claw.
Dialogue: Marked=0,0:24:06.90,0:24:08.33,*Default,NTP,0000,0000,0000,!Effect,Cobalt Claw.
Dialogue: Marked=0,0:24:11.23,0:24:12.48,*Default,NTP,0000,0000,0000,!Effect,Gold Claw.
Dialogue: Marked=0,0:24:15.01,0:24:16.63,*Default,NTP,0000,0000,0000,!Effect,Scarlet Claw.
Dialogue: Marked=0,0:24:18.01,0:24:20.33,*Default,NTP,0000,0000,0000,!Effect,Nejprve věrní služebníci Paní Jill,
Dialogue: Marked=0,0:24:20.33,0:24:22.47,*Default,NTP,0000,0000,0000,!Effect,...deset tisíc vojáků.
Dialogue: Marked=0,0:24:25.71,0:24:27.61,*Default,NTP,0000,0000,0000,!Effect,Pak výživa Paní Jill,
Dialogue: Marked=0,0:24:27.61,0:24:32.24,*Default,NTP,0000,0000,0000,!Effect,...představuji vám roky života svěžích lidských žen.
Dialogue: Marked=0,0:24:35.06,0:24:41.22,*Default,NTP,0000,0000,0000,!Effect,Dále naplním tužby překrásné a mocné Paní Jill zbraněmi ze solidního zlata!
Dialogue: Marked=0,0:24:44.42,0:24:45.65,*Default,NTP,0000,0000,0000,!Effect,A konečně,
Dialogue: Marked=0,0:24:45.65,0:24:49.58,*Default,NTP,0000,0000,0000,!Effect,...pro překrásnou a důležitou Paní Jill,
Dialogue: Marked=0,0:24:49.58,0:24:54.59,*Default,NTP,0000,0000,0000,!Effect,...přináším nově zkonstruovanou Věž Jill.
Dialogue: Marked=0,0:24:57.11,0:24:59.95,*Default,NTP,0000,0000,0000,!Effect,Pokud vámi zmítá nějaká tužba,
Dialogue: Marked=0,0:24:59.95,0:25:03.11,*Default,NTP,0000,0000,0000,!Effect,...stačí jen přikázat...
Dialogue: Marked=0,0:25:03.11,0:25:05.38,*Default,NTP,0000,0000,0000,!Effect,...a bezprostředně ji vyplníme.
Dialogue: Marked=0,0:25:05.38,0:25:06.24,*Default,NTP,0000,0000,0000,!Effect,Dovolte nám odejít.
Dialogue: Marked=0,0:25:11.25,0:25:13.11,*Default,NTP,0000,0000,0000,!Effect,Nudné.
Dialogue: Marked=0,0:25:13.11,0:25:18.18,*Default,NTP,0000,0000,0000,!Effect,Nic se nezměnilo na tomto ubíjejícím světě.
Dialogue: Marked=0,0:25:18.18,0:25:20.29,*Default,NTP,0000,0000,0000,!Effect,Paní Jill,
Dialogue: Marked=0,0:25:20.29,0:25:26.33,*Default,NTP,0000,0000,0000,!Effect,Je tu jedna maličkost, o které bych vás rád informoval.
Dialogue: Marked=0,0:25:26.56,0:25:28.60,*Default,NTP,0000,0000,0000,!Effect,Tak to jsou Panther Claw.
Dialogue: Marked=0,0:25:28.60,0:25:32.04,*Default,NTP,0000,0000,0000,!Effect,Nejdřív to byl otec a teď mají taky strýčka Utsugiho?
Dialogue: Marked=0,0:25:32.04,0:25:33.34,*Default,NTP,0000,0000,0000,!Effect,Neodpustíte jim?
Dialogue: Marked=0,0:25:34.02,0:25:35.13,*Default,NTP,0000,0000,0000,!Effect,Jistěže ne!
Dialogue: Marked=0,0:25:40.92,0:25:42.92,*Default,NTP,0000,0000,0000,!Effect,Pomsta je marná námaha.
Dialogue: Marked=0,0:25:43.19,0:25:44.84,*Default,NTP,0000,0000,0000,!Effect,Měla byste to vzdát.
Dialogue: Marked=0,0:25:44.84,0:25:45.97,*Default,NTP,0000,0000,0000,!Effect,Co myslíte?
Dialogue: Marked=0,0:25:45.97,0:25:48.18,*Default,NTP,0000,0000,0000,!Effect,Nenávist není pro vás.
Dialogue: Marked=0,0:25:48.84,0:25:52.57,*Default,NTP,0000,0000,0000,!Effect,Pokud bojujete z tohoto důvodu, nemyslím, že by byl váš otec šťastný.
Dialogue: Marked=0,0:25:52.57,0:25:53.90,*Default,NTP,0000,0000,0000,!Effect,Tak co mám dělat?
Dialogue: Marked=0,0:25:54.02,0:25:55.78,*Default,NTP,0000,0000,0000,!Effect,Budete muset najít sebe sama.
Dialogue: Marked=0,0:25:56.47,0:25:57.38,*Default,NTP,0000,0000,0000,!Effect,Kecy.
Dialogue: Marked=0,0:25:57.38,0:26:01.39,*Default,NTP,0000,0000,0000,!Effect,V každém případě už na vás zaměřili pozornost. Jsem si jistý, že zaútočí znovu.
Dialogue: Marked=0,0:26:01.39,0:26:02.59,*Default,NTP,0000,0000,0000,!Effect,Buďte opatrná.
Dialogue: Marked=0,0:26:02.59,0:26:03.83,*Default,NTP,0000,0000,0000,!Effect,Nepodceňujte je.
Dialogue: Marked=0,0:26:05.68,0:26:07.45,*Default,NTP,0000,0000,0000,!Effect,Vypadá to, že nás někdo sleduje.
Dialogue: Marked=0,0:26:08.17,0:26:09.90,*Default,NTP,0000,0000,0000,!Effect,To je očividné.
Dialogue: Marked=0,0:26:13.56,0:26:15.45,*Default,NTP,0000,0000,0000,!Effect,Ano, bez problémů.
Dialogue: Marked=0,0:26:15.45,0:26:16.87,*Default,NTP,0000,0000,0000,!Effect,Netuší nic.
Dialogue: Marked=0,0:26:18.66,0:26:21.76,*Default,NTP,0000,0000,0000,!Effect,Příliš riskují. Zastavují.
Dialogue: Marked=0,0:26:26.76,0:26:28.65,*Default,NTP,0000,0000,0000,!Effect,Dveře se otvírají a žena vystupuje.
Dialogue: Marked=0,0:26:28.66,0:26:30.55,*Default,NTP,0000,0000,0000,!Effect,Co máme dělat?
Dialogue: Marked=0,0:26:30.55,0:26:32.18,*Default,NTP,0000,0000,0000,!Effect,Zamávala!
Dialogue: Marked=0,0:26:32.18,0:26:33.25,*Default,NTP,0000,0000,0000,!Effect,Sledujte ženu.
Dialogue: Marked=0,0:26:33.25,0:26:34.30,*Default,NTP,0000,0000,0000,!Effect,Provedu!
Dialogue: Marked=0,0:26:34.30,0:26:35.39,*Default,NTP,0000,0000,0000,!Effect,Sledujeme ji!
Dialogue: Marked=0,0:27:08.19,0:27:09.25,*Default,NTP,0000,0000,0000,!Effect,Ale ne!
Dialogue: Marked=0,0:27:10.55,0:27:11.30,*Default,NTP,0000,0000,0000,!Effect,Uvidíme se!
Dialogue: Marked=0,0:27:13.01,0:27:16.45,*Default,NTP,0000,0000,0000,!Effect,Ale ne! Teď už je opravdu pozdě!
Dialogue: Marked=0,0:27:52.69,0:27:54.15,*Default,NTP,0000,0000,0000,!Effect,To světlo...
Dialogue: Marked=0,0:27:54.70,0:27:56.00,*Default,NTP,0000,0000,0000,!Effect,Jasně...
Dialogue: Marked=0,0:27:57.82,0:28:03.94,*Default,NTP,0000,0000,0000,!Effect,Takže neznámá žena jménem Cutie Honey?
Dialogue: Marked=0,0:28:03.94,0:28:08.81,*Default,NTP,0000,0000,0000,!Effect,Má stejné schopnosti jako naše čtyřka a může s nimi bojovat.
Dialogue: Marked=0,0:28:08.81,0:28:13.21,*Default,NTP,0000,0000,0000,!Effect,Vypadá to, že vlastní obdobný systém.
Dialogue: Marked=0,0:28:13.21,0:28:15.34,*Default,NTP,0000,0000,0000,!Effect,Zajímavé.
Dialogue: Marked=0,0:28:16.87,0:28:18.43,*Default,NTP,0000,0000,0000,!Effect,Najděte ji.
Dialogue: Marked=0,0:28:19.76,0:28:20.76,*Default,NTP,0000,0000,0000,!Effect,Jak si přejete.
Dialogue: Marked=0,0:28:22.31,0:28:29.95,*Default,NTP,0000,0000,0000,!Effect,Podle zpráv dcera profesora Kisaragiho zemřela před rokem při nehodě.
Dialogue: Marked=0,0:28:29.96,0:28:31.85,*Default,NTP,0000,0000,0000,!Effect,Ano, vím.
Dialogue: Marked=0,0:28:32.76,0:28:36.66,*Default,NTP,0000,0000,0000,!Effect,Ale také víme, že ta dcera je klíčem k I Systému.
Dialogue: Marked=0,0:28:37.36,0:28:39.83,*Default,NTP,0000,0000,0000,!Effect,Kontaktujte mne, když něco získáte.
Dialogue: Marked=0,0:28:39.83,0:28:41.93,*Default,NTP,0000,0000,0000,!Effect,Ano, bude to už brzo.
Dialogue: Marked=0,0:28:50.90,0:28:55.47,*Default,NTP,0000,0000,0000,!Effect,Tak, co dál?
Dialogue: Marked=0,0:29:12.14,0:29:13.70,*Default,NTP,0000,0000,0000,!Effect,Dobré ráno!
Dialogue: Marked=0,0:29:14.03,0:29:15.37,*Default,NTP,0000,0000,0000,!Effect,Tohle už není dobré ráno!
Dialogue: Marked=0,0:29:15.38,0:29:16.99,*Default,NTP,0000,0000,0000,!Effect,Už je dávno dobré odpoledne!
Dialogue: Marked=0,0:29:17.49,0:29:22.09,*Default,NTP,0000,0000,0000,!Effect,Poslouchejte, proč jste tady?
Dialogue: Marked=0,0:29:24.33,0:29:27.90,*Default,NTP,0000,0000,0000,!Effect,Promiňte, ale tady se pracuje, víte?
Dialogue: Marked=0,0:29:28.70,0:29:31.48,*Default,NTP,0000,0000,0000,!Effect,Sekční šéf divize Veřejné Bezpečnosti, detektiv Aki Natsuko.
Dialogue: Marked=0,0:29:32.59,0:29:33.88,*Default,NTP,0000,0000,0000,!Effect,Je to nepochybné.
Dialogue: Marked=0,0:29:35.18,0:29:38.06,*Default,NTP,0000,0000,0000,!Effect,To je ta komisařka, co jsme viděli s tou dívkou.
Dialogue: Marked=0,0:29:38.06,0:29:40.44,*Default,NTP,0000,0000,0000,!Effect,Bude tu nejspíš nějaké spojení.
Dialogue: Marked=0,0:29:40.44,0:29:43.00,*Default,NTP,0000,0000,0000,!Effect,Taková syrová zpráva.
Dialogue: Marked=0,0:29:44.06,0:29:44.78,*Default,NTP,0000,0000,0000,!Effect,No dobře.
Dialogue: Marked=0,0:29:44.91,0:29:50.51,*Default,NTP,0000,0000,0000,!Effect,Pokud to bude omyl, zbavíme se jí.
Dialogue: Marked=0,0:30:02.21,0:30:04.69,*Default,NTP,0000,0000,0000,!Effect,Hele, nejedla jsi onigiri včera ráno?
Dialogue: Marked=0,0:30:04.69,0:30:07.08,*Default,NTP,0000,0000,0000,!Effect,Jedla, správně.
Dialogue: Marked=0,0:30:11.10,0:30:14.66,*Default,NTP,0000,0000,0000,!Effect,Slečna Kisaragi zase civí.
Dialogue: Marked=0,0:30:15.27,0:30:17.72,*Default,NTP,0000,0000,0000,!Effect,Pěkně divné!
Dialogue: Marked=0,0:30:17.83,0:30:20.67,*Default,NTP,0000,0000,0000,!Effect,To protože nemá přítele s kterým by mluvila.
Dialogue: Marked=0,0:30:21.38,0:30:22.98,*Default,NTP,0000,0000,0000,!Effect,Je tu někdo, kdo tě chce vidět!
Dialogue: Marked=0,0:30:23.51,0:30:25.16,*Default,NTP,0000,0000,0000,!Effect,To je poprvé, viď?
Dialogue: Marked=0,0:30:25.16,0:30:26.03,*Default,NTP,0000,0000,0000,!Effect,Jo!
Dialogue: Marked=0,0:30:30.05,0:30:31.21,*Default,NTP,0000,0000,0000,!Effect,Nat-chan!
Dialogue: Marked=0,0:30:32.13,0:30:32.71,*Default,NTP,0000,0000,0000,!Effect,Čau!
Dialogue: Marked=0,0:30:32.71,0:30:34.12,*Default,NTP,0000,0000,0000,!Effect,Chceš zase utéct?
Dialogue: Marked=0,0:30:34.12,0:30:36.00,*Default,NTP,0000,0000,0000,!Effect,Není to proto, že se cítíš provinile?
Dialogue: Marked=0,0:30:36.00,0:30:36.86,*Default,NTP,0000,0000,0000,!Effect,Ne, rozhodně ne!
Dialogue: Marked=0,0:30:37.47,0:30:39.72,*Default,NTP,0000,0000,0000,!Effect,Mám pár otázek.
Dialogue: Marked=0,0:30:40.22,0:30:41.87,*Default,NTP,0000,0000,0000,!Effect,Ale teď jsem uprostřed práce.
Dialogue: Marked=0,0:30:42.41,0:30:44.04,*Default,NTP,0000,0000,0000,!Effect,Tady to není dobré.
Dialogue: Marked=0,0:30:44.32,0:30:45.34,*Default,NTP,0000,0000,0000,!Effect,Odpočívárna.
Dialogue: Marked=0,0:30:47.23,0:30:51.11,*Default,NTP,0000,0000,0000,!Effect,To jsem ráda, drahá. Konečně máš přítele!
Dialogue: Marked=0,0:30:51.11,0:30:51.84,*Default,NTP,0000,0000,0000,!Effect,Tady!
Dialogue: Marked=0,0:30:51.84,0:30:55.15,*Default,NTP,0000,0000,0000,!Effect,Promiň, ale piji jen černý Blue Mountain.
Dialogue: Marked=0,0:30:55.16,0:30:57.30,*Default,NTP,0000,0000,0000,!Effect,Ach, taková snobárna.
Dialogue: Marked=0,0:30:57.30,0:30:58.76,*Default,NTP,0000,0000,0000,!Effect,Aspoň víc zbyde.
Dialogue: Marked=0,0:31:12.64,0:31:13.98,*Default,NTP,0000,0000,0000,!Effect,Takže...
Dialogue: Marked=0,0:31:14.02,0:31:14.94,*Default,NTP,0000,0000,0000,!Effect,Ne!
Dialogue: Marked=0,0:31:16.58,0:31:18.50,*Default,NTP,0000,0000,0000,!Effect,Nikdy to neskončí!
Dialogue: Marked=0,0:31:18.50,0:31:19.81,*Default,NTP,0000,0000,0000,!Effect,Patetické.
Dialogue: Marked=0,0:31:19.81,0:31:22.01,*Default,NTP,0000,0000,0000,!Effect,Nenávidím plačící ženy!
Dialogue: Marked=0,0:31:25.51,0:31:26.91,*Default,NTP,0000,0000,0000,!Effect,Dostanu se z toho.
Dialogue: Marked=0,0:31:26.92,0:31:30.78,*Default,NTP,0000,0000,0000,!Effect,Jen tohle muži chtějí. Všichni muži chtějí jen mladé ženy, co?
Dialogue: Marked=0,0:31:30.78,0:31:32.70,*Default,NTP,0000,0000,0000,!Effect,Tak hloupé!
Dialogue: Marked=0,0:31:33.00,0:31:35.23,*Default,NTP,0000,0000,0000,!Effect,No, a mejkap je v čudu.
Dialogue: Marked=0,0:31:36.60,0:31:38.68,*Default,NTP,0000,0000,0000,!Effect,Co tu děláte? Zpátky do práce!
Dialogue: Marked=0,0:31:38.68,0:31:40.78,*Default,NTP,0000,0000,0000,!Effect,Nechci vidět vaši hloupou tvář!
Dialogue: Marked=0,0:31:40.78,0:31:42.08,*Default,NTP,0000,0000,0000,!Effect,Omlouvám se!
Dialogue: Marked=0,0:31:42.60,0:31:45.00,*Default,NTP,0000,0000,0000,!Effect,Tady je to taky špatné. Pojď se mnou.
Dialogue: Marked=0,0:31:45.78,0:31:46.69,*Default,NTP,0000,0000,0000,!Effect,Ach, dobře...
Dialogue: Marked=0,0:31:46.69,0:31:51.58,*Default,NTP,0000,0000,0000,!Effect,Sakra, co s tím druhým chlapem?
Dialogue: Marked=0,0:32:03.72,0:32:05.64,*Default,NTP,0000,0000,0000,!Effect,Tak, máš problém.
Dialogue: Marked=0,0:32:05.64,0:32:07.63,*Default,NTP,0000,0000,0000,!Effect,Hledala jsem tě v databázi Veřejné Bezpečnosti.
Dialogue: Marked=0,0:32:07.63,0:32:09.38,*Default,NTP,0000,0000,0000,!Effect,Není tam jediný záznam. Neexistuješ.
Dialogue: Marked=0,0:32:09.46,0:32:10.73,*Default,NTP,0000,0000,0000,!Effect,Takže, co jsi zač?
Dialogue: Marked=0,0:32:10.73,0:32:11.90,*Default,NTP,0000,0000,0000,!Effect,Jaký máš vztah k Cutie Honey?
Dialogue: Marked=0,0:32:11.90,0:32:13.07,*Default,NTP,0000,0000,0000,!Effect,Kdo je ten novinář?
Dialogue: Marked=0,0:32:13.86,0:32:14.92,*Default,NTP,0000,0000,0000,!Effect,Kde jsou Panther Claw?
Dialogue: Marked=0,0:32:17.08,0:32:19.38,*Default,NTP,0000,0000,0000,!Effect,Pěkně mi to všechno hned teď vyklop.
Dialogue: Marked=0,0:32:20.73,0:32:23.06,*Default,NTP,0000,0000,0000,!Effect,Použiji všechny prostředky, abych dosáhla cíle.
Dialogue: Marked=0,0:32:23.56,0:32:24.73,*Default,NTP,0000,0000,0000,!Effect,A není to jen fráze.
Dialogue: Marked=0,0:32:27.29,0:32:28.30,*Default,NTP,0000,0000,0000,!Effect,Sakra...
Dialogue: Marked=0,0:32:28.31,0:32:29.82,*Default,NTP,0000,0000,0000,!Effect,Kdo to, k čertu, je?
Dialogue: Marked=0,0:32:29.82,0:32:31.50,*Default,NTP,0000,0000,0000,!Effect,To jsem já, Hayami Seiji.
Dialogue: Marked=0,0:32:31.58,0:32:33.83,*Default,NTP,0000,0000,0000,!Effect,Vy! Jak jste získal mé číslo?!
Dialogue: Marked=0,0:32:33.83,0:32:35.34,*Default,NTP,0000,0000,0000,!Effect,Pátrání je má práce.
Dialogue: Marked=0,0:32:35.34,0:32:38.19,*Default,NTP,0000,0000,0000,!Effect,Ale nemůžete být tak bezstarostná!
Dialogue: Marked=0,0:32:39.03,0:32:40.87,*Default,NTP,0000,0000,0000,!Effect,Nepřátelé už vás hledají.
Dialogue: Marked=0,0:32:41.16,0:32:42.06,*Default,NTP,0000,0000,0000,!Effect,O čem to mluvíte?
Dialogue: Marked=0,0:32:50.38,0:32:52.85,*Default,NTP,0000,0000,0000,!Effect,Takže už je u nich Panther Claw!
Dialogue: Marked=0,0:33:20.57,0:33:22.23,*Default,NTP,0000,0000,0000,!Effect,{\i1}Dveře se zavírají.{\i0}
Dialogue: Marked=0,0:33:27.12,0:33:29.28,*Default,NTP,0000,0000,0000,!Effect,Hej ty, nech toho!
Dialogue: Marked=0,0:33:29.28,0:33:31.59,*Default,NTP,0000,0000,0000,!Effect,O takovou situaci se dokážu postarat sama.
Dialogue: Marked=0,0:33:31.59,0:33:32.68,*Default,NTP,0000,0000,0000,!Effect,Promiň.
Dialogue: Marked=0,0:33:35.67,0:33:37.47,*Default,NTP,0000,0000,0000,!Effect,Ale co, sakra, bylo tohle?
Dialogue: Marked=0,0:33:37.47,0:33:38.45,*Default,NTP,0000,0000,0000,!Effect,Víš něco?
Dialogue: Marked=0,0:33:38.45,0:33:43.93,*Default,NTP,0000,0000,0000,!Effect,No, něco vím, ale nevím... nevím...
Dialogue: Marked=0,0:33:43.93,0:33:46.31,*Default,NTP,0000,0000,0000,!Effect,Podezřelé... Rozhodně podezřelé!
Dialogue: Marked=0,0:33:47.18,0:33:49.27,*Default,NTP,0000,0000,0000,!Effect,No na velitelství vyklopíš všechno!
Dialogue: Marked=0,0:33:51.51,0:33:53.36,*Default,NTP,0000,0000,0000,!Effect,Co, sakra?!
Dialogue: Marked=0,0:33:57.54,0:33:58.09,*Default,NTP,0000,0000,0000,!Effect,Nat-chan!
Dialogue: Marked=0,0:34:02.56,0:34:04.74,*Default,NTP,0000,0000,0000,!Effect,Neuniknete!
Dialogue: Marked=0,0:34:05.09,0:34:08.18,*Default,NTP,0000,0000,0000,!Effect,Tak, povězte všechno o Honey. Hned!
Dialogue: Marked=0,0:34:08.18,0:34:09.61,*Default,NTP,0000,0000,0000,!Effect,Jinak...
Dialogue: Marked=0,0:34:11.80,0:34:12.94,*Default,NTP,0000,0000,0000,!Effect,Mluvte! Rychle!
Dialogue: Marked=0,0:34:12.94,0:34:14.69,*Default,NTP,0000,0000,0000,!Effect,Tak tohle bych chtěla sama vědět!
Dialogue: Marked=0,0:34:14.69,0:34:17.48,*Default,NTP,0000,0000,0000,!Effect,Božínku, špatná odpověď!
Dialogue: Marked=0,0:34:41.83,0:34:44.89,*Default,NTP,0000,0000,0000,!Effect,HONEY FLASH!
Dialogue: Marked=0,0:34:55.89,0:34:58.22,*Default,NTP,0000,0000,0000,!Effect,{\i1}Prodigieux!{\i0}
Dialogue: Marked=0,0:34:58.22,0:35:00.41,*Default,NTP,0000,0000,0000,!Effect,Vy! Vy jste Panther Claw?
Dialogue: Marked=0,0:35:00.41,0:35:02.01,*Default,NTP,0000,0000,0000,!Effect,Trefa!
Dialogue: Marked=0,0:35:02.32,0:35:05.02,*Default,NTP,0000,0000,0000,!Effect,Jsem jedna ze čtyř Panther Claw.
Dialogue: Marked=0,0:35:05.51,0:35:10.53,*Default,NTP,0000,0000,0000,!Effect,Já Cobalt Claw si vezmu to podivné zařízení...
Dialogue: Marked=0,0:35:11.33,0:35:13.42,*Default,NTP,0000,0000,0000,!Effect,...na vašem krku!
Dialogue: Marked=0,0:35:14.20,0:35:18.44,*Default,NTP,0000,0000,0000,!Effect,Pomstím svého otce! Panther Claw, nikdy vám to nevydám!
Dialogue: Marked=0,0:35:18.57,0:35:19.75,*Default,NTP,0000,0000,0000,!Effect,Cutie Honey...
Dialogue: Marked=0,0:35:20.17,0:35:21.33,*Default,NTP,0000,0000,0000,!Effect,...je takhle dívka?
Dialogue: Marked=0,0:35:21.33,0:35:23.45,*Default,NTP,0000,0000,0000,!Effect,Vezmu si co chci!
Dialogue: Marked=0,0:35:30.40,0:35:33.73,*Default,NTP,0000,0000,0000,!Effect,Mé touhy a mé potěšení,
Dialogue: Marked=0,0:35:33.73,0:35:36.96,*Default,NTP,0000,0000,0000,!Effect,...to je můj styl.
Dialogue: Marked=0,0:35:37.10,0:35:38.24,*Default,NTP,0000,0000,0000,!Effect,Jaký styl?
Dialogue: Marked=0,0:35:38.25,0:35:41.47,*Default,NTP,0000,0000,0000,!Effect,Musíme brát ohled na ostatní!
Dialogue: Marked=0,0:35:55.59,0:35:57.27,*Default,NTP,0000,0000,0000,!Effect,Mám tě!
Dialogue: Marked=0,0:36:04.48,0:36:06.78,*Default,NTP,0000,0000,0000,!Effect,{\i1}Božínku!{\i0} Takový zázračný křik!
Dialogue: Marked=0,0:36:06.78,0:36:11.32,*Default,NTP,0000,0000,0000,!Effect,Pro tohle nemohu přestat se zabíjením lidí.
Dialogue: Marked=0,0:36:11.32,0:36:15.30,*Default,NTP,0000,0000,0000,!Effect,Ty! To tys zabila před rokem mého otce?
Dialogue: Marked=0,0:36:15.30,0:36:16.12,*Default,NTP,0000,0000,0000,!Effect,Kdo to byl?
Dialogue: Marked=0,0:36:16.22,0:36:20.15,*Default,NTP,0000,0000,0000,!Effect,Hm, ty si pamatuješ, cos jedla před rokem?
Dialogue: Marked=0,0:36:20.15,0:36:23.30,*Default,NTP,0000,0000,0000,!Effect,Panther Claw! Nikdy vám neodpustím!
Dialogue: Marked=0,0:36:27.77,0:36:30.54,*Default,NTP,0000,0000,0000,!Effect,Víš, tak tohle mne vůbec netrápí.
Dialogue: Marked=0,0:36:32.90,0:36:37.04,*Default,NTP,0000,0000,0000,!Effect,Bože, ale s tímhle horkem souhlasit nemohu.
Dialogue: Marked=0,0:36:45.49,0:36:47.03,*Default,NTP,0000,0000,0000,!Effect,To pálí!
Dialogue: Marked=0,0:36:47.76,0:36:49.37,*Default,NTP,0000,0000,0000,!Effect,Tak, teď poznáš co je to cítit!
Dialogue: Marked=0,0:36:49.54,0:36:51.81,*Default,NTP,0000,0000,0000,!Effect,Ne! To bolí!
Dialogue: Marked=0,0:36:51.81,0:36:53.29,*Default,NTP,0000,0000,0000,!Effect,To bolí!
Dialogue: Marked=0,0:36:54.14,0:36:55.27,*Default,NTP,0000,0000,0000,!Effect,Jste v pořádku? To je dobré!
Dialogue: Marked=0,0:36:55.28,0:36:57.38,*Default,NTP,0000,0000,0000,!Effect,Není to dobré! Jak se můžete cítit v pekle?!
Dialogue: Marked=0,0:36:57.47,0:36:58.22,*Default,NTP,0000,0000,0000,!Effect,Co je s Honey?
Dialogue: Marked=0,0:36:58.22,0:36:59.51,*Default,NTP,0000,0000,0000,!Effect,Nevím jak, ale rozpálila se!
Dialogue: Marked=0,0:36:59.51,0:37:01.98,*Default,NTP,0000,0000,0000,!Effect,To je zlé! Musíte ji dostat zpátky!
Dialogue: Marked=0,0:37:03.51,0:37:05.49,*Default,NTP,0000,0000,0000,!Effect,Počítám s vámi, Nat-chan!
Dialogue: Marked=0,0:37:05.49,0:37:06.34,*Default,NTP,0000,0000,0000,!Effect,Počkejte u telefonu!
Dialogue: Marked=0,0:37:07.97,0:37:09.64,*Default,NTP,0000,0000,0000,!Effect,Počítá se mnou?!
Dialogue: Marked=0,0:37:11.65,0:37:12.66,*Default,NTP,0000,0000,0000,!Effect,Hej ty!
Dialogue: Marked=0,0:37:12.67,0:37:14.65,*Default,NTP,0000,0000,0000,!Effect,Musíš toho nechat!
Dialogue: Marked=0,0:37:14.65,0:37:17.25,*Default,NTP,0000,0000,0000,!Effect,Ne! Pokud se zastavím, nepomstím tátu!
Dialogue: Marked=0,0:37:19.63,0:37:22.63,*Default,NTP,0000,0000,0000,!Effect,Hned toho nech! Zločinci patří za mříže! Hned to vypni!
Dialogue: Marked=0,0:37:22.63,0:37:23.57,*Default,NTP,0000,0000,0000,!Effect,Mlč!
Dialogue: Marked=0,0:37:23.57,0:37:24.90,*Default,NTP,0000,0000,0000,!Effect,Nikdy jim neodpustím!
Dialogue: Marked=0,0:38:36.09,0:38:42.68,*Default,NTP,0000,0000,0000,!Effect,Hněv a nenávist slečny Honey upekla Cobalt Claw do křupava.
Dialogue: Marked=0,0:38:42.68,0:38:45.68,*Default,NTP,0000,0000,0000,!Effect,Slabí mne nezajímají.
Dialogue: Marked=0,0:38:45.68,0:38:47.62,*Default,NTP,0000,0000,0000,!Effect,Ale...
Dialogue: Marked=0,0:38:47.63,0:38:50.19,*Default,NTP,0000,0000,0000,!Effect,...vyzařování slečny Honey...
Dialogue: Marked=0,0:38:50.19,0:38:52.73,*Default,NTP,0000,0000,0000,!Effect,...zajímá vás to?
Dialogue: Marked=0,0:38:52.73,0:39:01.29,*Default,NTP,0000,0000,0000,!Effect,To znamená, že profesor Kisaragi byl úspěšný při vývoji nanostrojů manipulující s hmotou na základní úrovni.
Dialogue: Marked=0,0:39:01.29,0:39:06.33,*Default,NTP,0000,0000,0000,!Effect,Může to být ideální záruka mého věčného života.
Dialogue: Marked=0,0:39:06.33,0:39:10.99,*Default,NTP,0000,0000,0000,!Effect,Myslím, že existuje člověk, schopný tohle naplnit.
Dialogue: Marked=0,0:39:10.99,0:39:14.83,*Default,NTP,0000,0000,0000,!Effect,Nemohu pohrdat tímto světem.
Dialogue: Marked=0,0:39:16.14,0:39:19.79,*Default,NTP,0000,0000,0000,!Effect,Tohle je poprvé, kdy jste se usmála.
Dialogue: Marked=0,0:39:19.79,0:39:27.23,*Default,NTP,0000,0000,0000,!Effect,Nepotřebuji žádné podřadné věci.
Dialogue: Marked=0,0:39:59.62,0:40:03.09,*Default,NTP,0000,0000,0000,!Effect,Základem těla jsou lidské buňky a ty omezují její schopnosti.
Dialogue: Marked=0,0:40:03.09,0:40:06.76,*Default,NTP,0000,0000,0000,!Effect,Tak tohle může být její slabý bod.
Dialogue: Marked=0,0:40:50.68,0:40:52.04,*Default,NTP,0000,0000,0000,!Effect,Už vzhůru?
Dialogue: Marked=0,0:40:53.04,0:40:55.96,*Default,NTP,0000,0000,0000,!Effect,Díky! Zachránila jsi mne!
Dialogue: Marked=0,0:40:56.45,0:40:58.55,*Default,NTP,0000,0000,0000,!Effect,Vzhledem k okolnostem...
Dialogue: Marked=0,0:41:12.64,0:41:13.60,*Default,NTP,0000,0000,0000,!Effect,Ach!
Dialogue: Marked=0,0:41:15.70,0:41:18.56,*Default,NTP,0000,0000,0000,!Effect,Pokud ti to pomůže, opravdu jsem tě sem vzít nechtěla.
Dialogue: Marked=0,0:41:19.66,0:41:22.13,*Default,NTP,0000,0000,0000,!Effect,Ale ty...
Dialogue: Marked=0,0:41:22.13,0:41:26.30,*Default,NTP,0000,0000,0000,!Effect,Pokud ti to pomůže, opravdu o tom mluvit nechci.
Dialogue: Marked=0,0:41:30.31,0:41:31.78,*Default,NTP,0000,0000,0000,!Effect,Byl to dárek.
Dialogue: Marked=0,0:41:31.82,0:41:33.15,*Default,NTP,0000,0000,0000,!Effect,Od mého táty.
Dialogue: Marked=0,0:41:35.66,0:41:41.40,*Default,NTP,0000,0000,0000,!Effect,Mé tělo bylo před rokem zničeno při nehodě.
Dialogue: Marked=0,0:41:41.40,0:41:43.45,*Default,NTP,0000,0000,0000,!Effect,Ale znovuzrodila jsem se.
Dialogue: Marked=0,0:41:44.36,0:41:48.15,*Default,NTP,0000,0000,0000,!Effect,Díky vynálezu mého táty, I Systému.
Dialogue: Marked=0,0:41:48.15,0:41:49.61,*Default,NTP,0000,0000,0000,!Effect,I Systému?
Dialogue: Marked=0,0:41:49.61,0:41:52.94,*Default,NTP,0000,0000,0000,!Effect,Správně, Imaginary Induction System.
Dialogue: Marked=0,0:41:52.94,0:41:56.37,*Default,NTP,0000,0000,0000,!Effect,Tenhle obojek je jeho součástí.
Dialogue: Marked=0,0:41:57.25,0:42:00.94,*Default,NTP,0000,0000,0000,!Effect,Tak ty jsi robot?
Dialogue: Marked=0,0:42:00.94,0:42:03.29,*Default,NTP,0000,0000,0000,!Effect,Android?
Dialogue: Marked=0,0:42:10.75,0:42:12.33,*Default,NTP,0000,0000,0000,!Effect,Tomu nevěřím.
Dialogue: Marked=0,0:42:12.69,0:42:16.91,*Default,NTP,0000,0000,0000,!Effect,Vidíš, jsem stejná jako člověk.
Dialogue: Marked=0,0:42:16.91,0:42:21.27,*Default,NTP,0000,0000,0000,!Effect,Tohle tělo je kopií mého předchozího.
Dialogue: Marked=0,0:42:21.27,0:42:26.37,*Default,NTP,0000,0000,0000,!Effect,Ale nemám žádné dřívější vzpomínky.
Dialogue: Marked=0,0:42:26.37,0:42:31.64,*Default,NTP,0000,0000,0000,!Effect,Jediné na co si vzpomínám, je, jak mne táta držel v rukou.
Dialogue: Marked=0,0:42:31.64,0:42:36.93,*Default,NTP,0000,0000,0000,!Effect,Ale mohu získat nové vzpomínky, správně?
Dialogue: Marked=0,0:42:41.37,0:42:44.85,*Default,NTP,0000,0000,0000,!Effect,První nezasvěcený poznal pravou totožnost Honey...
Dialogue: Marked=0,0:42:44.85,0:42:47.78,*Default,NTP,0000,0000,0000,!Effect,No, myslím, že je to v pořádku.
Dialogue: Marked=0,0:43:11.54,0:43:14.19,*Default,NTP,0000,0000,0000,!Effect,Promiň Nat-chan, že jsem tě do toho zatáhla.
Dialogue: Marked=0,0:43:16.02,0:43:18.77,*Default,NTP,0000,0000,0000,!Effect,Nestarej se, je to součást mé práce.
Dialogue: Marked=0,0:43:20.41,0:43:23.74,*Default,NTP,0000,0000,0000,!Effect,Dnes jsem si konečně uvědomila...
Dialogue: Marked=0,0:43:23.74,0:43:27.88,*Default,NTP,0000,0000,0000,!Effect,Cítit nenávist k někomu je opravdu děsivé.
Dialogue: Marked=0,0:43:29.95,0:43:34.11,*Default,NTP,0000,0000,0000,!Effect,Cítit lásku k někomu je opravdu děsivé.
Dialogue: Marked=0,0:43:34.11,0:43:41.35,*Default,NTP,0000,0000,0000,!Effect,Pokud je to stejné, pak bych raději někoho milovala.
Dialogue: Marked=0,0:43:42.86,0:43:44.37,*Default,NTP,0000,0000,0000,!Effect,Víš...
Dialogue: Marked=0,0:43:44.38,0:43:48.15,*Default,NTP,0000,0000,0000,!Effect,Je tohle to, o čem Seiji mluvil?
Dialogue: Marked=0,0:43:48.59,0:43:50.31,*Default,NTP,0000,0000,0000,!Effect,Jdeme spát.
Dialogue: Marked=0,0:43:56.69,0:43:58.12,*Default,NTP,0000,0000,0000,!Effect,Dobrou noc.
Dialogue: Marked=0,0:44:37.00,0:44:42.47,*Default,NTP,0000,0000,0000,!Effect,Mé tělo uvadá.
Dialogue: Marked=0,0:44:42.47,0:44:48.29,*Default,NTP,0000,0000,0000,!Effect,Musím mít brzy I Systém.
Dialogue: Marked=0,0:44:48.41,0:44:49.45,*Default,NTP,0000,0000,0000,!Effect,Paní.
Dialogue: Marked=0,0:45:17.56,0:45:18.34,*Default,NTP,0000,0000,0000,!Effect,Co je to?!
Dialogue: Marked=0,0:45:24.19,0:45:27.17,*Default,NTP,0000,0000,0000,!Effect,Mám radost! Kvetou!
Dialogue: Marked=0,0:45:31.22,0:45:33.42,*Default,NTP,0000,0000,0000,!Effect,Jsou opravdu překrásné, Nat-chan!
Dialogue: Marked=0,0:45:37.46,0:45:38.73,*Default,NTP,0000,0000,0000,!Effect,Zase jsi se do toho pletla!
Dialogue: Marked=0,0:45:59.99,0:46:00.80,*Default,NTP,0000,0000,0000,!Effect,No tak...
Dialogue: Marked=0,0:46:01.82,0:46:02.77,*Default,NTP,0000,0000,0000,!Effect,No tak...
Dialogue: Marked=0,0:46:03.96,0:46:04.99,*Default,NTP,0000,0000,0000,!Effect,Co?
Dialogue: Marked=0,0:46:04.99,0:46:06.94,*Default,NTP,0000,0000,0000,!Effect,Ale ony kvetou.
Dialogue: Marked=0,0:46:09.44,0:46:11.82,*Default,NTP,0000,0000,0000,!Effect,Použila jsi sílu I Systému, viď?
Dialogue: Marked=0,0:46:12.31,0:46:13.22,*Default,NTP,0000,0000,0000,!Effect,Jo.
Dialogue: Marked=0,0:46:13.22,0:46:17.49,*Default,NTP,0000,0000,0000,!Effect,I Systém může oživit živé věci.
Dialogue: Marked=0,0:46:17.49,0:46:22.02,*Default,NTP,0000,0000,0000,!Effect,Ale nemůže stvořit nový život.
Dialogue: Marked=0,0:46:22.55,0:46:26.09,*Default,NTP,0000,0000,0000,!Effect,Proto miluji živé věci.
Dialogue: Marked=0,0:46:27.17,0:46:29.15,*Default,NTP,0000,0000,0000,!Effect,To nemá žádný význam.
Dialogue: Marked=0,0:46:29.15,0:46:31.82,*Default,NTP,0000,0000,0000,!Effect,Zbytečně jsi se namáhala, když jsi je donutila je kvést.
Dialogue: Marked=0,0:46:32.59,0:46:34.17,*Default,NTP,0000,0000,0000,!Effect,Promiň.
Dialogue: Marked=0,0:46:38.94,0:46:40.67,*Default,NTP,0000,0000,0000,!Effect,Cítíš se teď líp, že?
Dialogue: Marked=0,0:46:41.64,0:46:43.42,*Default,NTP,0000,0000,0000,!Effect,Tak co kdybys šla.
Dialogue: Marked=0,0:07:30.07,0:07:32.41,*Default,,0000,0000,0070,,{\a6\3c&H770088&\1c&HCC00FF\bord4\fs80\t(0,3000,\fs74) \fry-90\t(0,100,\fry0)}Sailor Spork uvádí...
Dialogue: Marked=0,0:07:30.07,0:07:32.41,*Default,,0000,0000,0000,,{\a3\fad(500,500)\fs50\3c&HFF0000&}http://sailorspork.8m.net/ http://umino.gurio.sweb.cz/
